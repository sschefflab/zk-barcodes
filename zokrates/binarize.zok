from "EMBED" import value_in_array;
from "./const_range_check" import RANGE_0_128 as table;

def binarize<N>(field[N] image, bool[N] bin_image) -> bool {
    for u32 i in 0..N {
        field to_lookup =
            if bin_image[i] {
                image[i] - 128
            } else {
                image[i]
            };
        assert(value_in_array(to_lookup, table));
    }

    return true;
}

// test main function
const u32 N = 32;

def main(private field[N] image, private bool[N] bin_image) -> () {
    assert(binarize(image, bin_image));
}
