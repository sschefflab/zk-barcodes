// Check that the original image and the binarized image are consistent

from "EMBED" import value_in_array;
from "./const_range_check" import RANGE_0_128 as table;

def binarize<IR, IC, R,C, R_START, C_START>(field[IR][IC] image, field[R][C] bin_image) -> bool {
    for u32 r in R_START..(R_START + R) {
        for u32 c in C_START..(C_START + C) {
            u32 bin_r = r - R_START;
            u32 bin_c = c - C_START;
            assert(bin_image[bin_r][bin_c]*(1-bin_image[bin_r][bin_c]) == 0);
            field to_lookup = image[r][c] - 128 * (1 - bin_image[bin_r][bin_c]); // if bin_image = 0, lookup image[i] - 128. Else, lookup image[i]
            assert(value_in_array(to_lookup, table));
        }
    }

    return true;
}

// test main function
const u32 IR = 144;
const u32 IC = 192;
const u32 R = 140;
const u32 C = 188;
const u32 R_START = 2;
const u32 C_START = 2;

def main(private field[IR][IC] image, private field[R][C] bin_image) -> () {
    assert(binarize::<IR, IC, R, C, R_START, C_START>(image, bin_image));
}
