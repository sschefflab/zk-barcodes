// Check that the original image and the binarized image are consistent

from "EMBED" import value_in_array;
from "./const_range_check" import RANGE_0_128 as table;

def binarize<R,C>(field[R][C] image, field[R][C] bin_image) -> bool {
    bool mut all_binary = true;
    for u32 r in 0..R {
        for u32 c in 0..C {
            all_binary = all_binary && (bin_image[r][c]*(1-bin_image[r][c]) == 0);
            field to_lookup = image[r][c] - 128 * (1 - bin_image[r][c]); // if bin_image = 0, lookup image[i] - 128. Else, lookup image[i]
            assert(value_in_array(to_lookup, table));
        }
    }

    return all_binary;
}

// test main function
const u32 R = 4;
const u32 C = 8;

def main(private field[R][C] image, private field[R][C] bin_image) -> () {
    assert(binarize(image, bin_image));
}
