from "EMBED" import value_in_array;
from "./const_range_check" import RANGE_0_128 as table;

def binarize<N>(field[N] image, field[N] bin_image) -> bool {
    bool mut all_binary = true;
    for u32 i in 0..N {
        all_binary = all_binary && (bin_image[i]*(1-bin_image[i]) == 0);
        field to_lookup = image[i] - 128 * (1 - bin_image[i]); // if bin_image = 0, lookup image[i] - 128. Else, lookup image[i]
        assert(value_in_array(to_lookup, table));
    }

    return all_binary;
}

// test main function
const u32 N = 32;

def main(private field[N] image, private field[N] bin_image) -> () {
    assert(binarize(image, bin_image));
}
