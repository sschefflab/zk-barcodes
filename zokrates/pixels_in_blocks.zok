from "EMBED" import value_in_array, value_in_array_tuple, unpack;

const u32 L = 10;

// Assuming the largest image we handle is an HD image, this is the largest possible row size, and therefore the largest block size in pixels
// TODO: can we make this generic over R?
const u32 B = 1080;

const u32 TABLE_LEN = 2**L;
const field[TABLE_LEN][6] PIXELS_AND_BLOCKS = [[0; 6]; TABLE_LEN]; // TODO - fill this in

const field[L][2] POWERS_OF_B = [[0; 2]; L] // TODO - fill this in

// base-B values representing a series of blocks
type Blocks = field;

// a positive integer
type NumBlocks = field;

struct Lookup {
    field binary_enc;

    Blocks baseB_enc;
    Blocks remainder;

    NumBlocks num_blocks;

    field num_blocks_is_odd;
    field remainder_is_black;

    field power_of_B;
}

def pixels_to_binary<P>(field[P] pixels) -> field {
    field mut result = 0;
    for u32 i in 0..P {
        result = result + 2**i*pixels[i];
    }
    return(result);
}

def encode(Lookup lookup) -> field[6] {
    return([lookup.binary_enc, lookup.baseB_enc, lookup.remainder, lookup.num_blocks, lookup.num_blocks_is_odd, lookup.remainder_is_black]);
}

// always returns true, but does an assert inside
def check_blocks_for_chunk(Lookup lookup) -> bool {
    field[6] lookup_enc = encode(lookup);
    assert(value_in_array_tuple(lookup_enc, PIXELS_AND_BLOCKS);
    return true;
}

// TODO - FINISH
def check_blocks<R>(field[R] pixels, Lookup lookups[R/L + 1], field[B] blocks) -> bool {
    bool correct_blocks = true;

    u32 num_chunks = R/L + 1;
    for u32 i in 0..num_chunks {
        field[L] expanded_chunk = [0; L];
        
        for u32 j in 0..L {
            expanded_chunk[j] = pixels[i*L + j];
        }

        field binary_chunk = pixels_to_binary(expanded_chunk);
        correct_blocks = correct_blocks && (binary_chunk == lookups[i].binary_enc);        
    }

    field[num_chunks] mut all_blocks = [0; R];
    field[num_chunks] mut all_nb = [0; R];
    field mut remainder = 0;
    field mut black_r = 0;
    for u32 c in 0..num_chunks {
        bool always_true = check_blocks_for_chunk(lookup[c]);

        field a = lookup[c].remainder_is_black;
        field b = black_r;
        field c = lookup[c].num_blocks_is_odd;
        field offset = 1 - a - b - c + 2*a*b + 2*a*c + 2*b*c - 4*a*b*c;
        field exp = lookup[c].num_blocks - offset;

        assert(value_in_array_tuple([exp, lookup[c].power_of_B], POWERS_OF_B));

        all_blocks[c] = remainder*lookup[c].power_of_B + blocks;
        all_nb[c] = lookup[c].num_blocks + 1 - offset;

        remainder = lookup[c].remainder;
        black_r = lookup[c].remainder_is_black;
    }

    // TODO: this should not be powers of B - figure out how to compute these polynomials separately
    field[B] mut f = [0; B];
    field mut pow = 1;
    for u32 b in 0..B {
        f[b] = blocks[b] * pow;
        pow = pow * B;
    }

    field[B] mut g = [0; B];
    pow = 1;
    for u32 b in 0..B {
        field[L] baseB_decomp = 0; // TODO - fill in with the actual base-B decomp

        for u32 l in 0..L {
            baseB_decomp[l]
        }
    }
    

}
