 [980, 1361749839484, 2, 5, 1, 1], [981, 1470689826639484, 1, 6, 0, 0], [982, 2722238799484, 1, 5, 1, 1], [983, 1260879484, 3, 4, 0, 0], [984, 2333884, 3, 3, 1, 1], [985, 2521757884, 1, 4, 0, 0], [986, 1361751005884, 1, 5, 1, 1], [987, 1262045884, 2, 4, 0, 0], [988, 3500284, 2, 3, 1, 1], [989, 1263212284, 1, 4, 0, 0], [990, 4666684, 1, 3, 1, 1], [991, 1084, 5, 2, 0, 0], [992, 5, 5, 1, 1, 1], [993, 4325, 1, 2, 0, 0], [994, 1169645, 1, 3, 1, 1], [995, 3245, 2, 2, 0, 0], [996, 1168565, 2, 3, 1, 1], [997, 1260880565, 1, 4, 0, 0], [998, 2334965, 1, 3, 1, 1], [999, 2165, 3, 2, 0, 0], [1000, 1167485, 3, 3, 1, 1], [1001, 2520591485, 1, 4, 0, 0], [1002, 1361749839485, 1, 5, 1, 1], [1003, 1260879485, 2, 4, 0, 0], [1004, 2333885, 2, 3, 1, 1], [1005, 1262045885, 1, 4, 0, 0], [1006, 3500285, 1, 3, 1, 1], [1007, 1085, 4, 2, 0, 0], [1008, 6, 4, 1, 1, 1], [1009, 3246, 1, 2, 0, 0], [1010, 1168566, 1, 3, 1, 1], [1011, 2166, 2, 2, 0, 0], [1012, 1167486, 2, 3, 1, 1], [1013, 1260879486, 1, 4, 0, 0], [1014, 2333886, 1, 3, 1, 1], [1015, 1086, 3, 2, 0, 0], [1016, 7, 3, 1, 1, 1], [1017, 2167, 1, 2, 0, 0], [1018, 1167487, 1, 3, 1, 1], [1019, 1087, 2, 2, 0, 0], [1020, 8, 2, 1, 1, 1], [1021, 1088, 1, 2, 0, 0], [1022, 9, 1, 1, 1, 1], [1023, 0, 10, 0, 0, 0]];

const field[L][2] POWERS_OF_B = [[0, 1], [1, 1080], [2, 1166400], [3, 1259712000], [4, 1360488960000], [5, 1469328076800000], [6, 1586874322944000000], [7, 1713824268779520000000], [8, 1850930210281881600000000], [9, 1999004627104432128000000000]];

// base-B values representing a series of blocks
type Blocks = field;

// a positive integer
type NumBlocks = field;

struct BlockLookup {
    field binary_enc;

    Blocks baseB_enc;
    Blocks remainder;

    NumBlocks num_blocks;

    field num_blocks_is_odd;
    field remainder_is_black;

    field power_of_B;
}

def pixels_to_binary<P>(field[P] pixels) -> field {
    field mut result = 0;
    for u32 i in 0..P {
        result = result + 2**i*pixels[i];
    }
    return(result);
}

def encode(BlockLookup lookup) -> field[6] {
    return([lookup.binary_enc, lookup.baseB_enc, lookup.remainder, lookup.num_blocks, lookup.num_blocks_is_odd, lookup.remainder_is_black]);
}

// always returns true, but does an assert inside
def check_blocks_for_chunk(BlockLookup lookup) -> bool {
    field[6] lookup_enc = encode(lookup);
    assert(value_in_array_tuple(lookup_enc, PIXELS_AND_BLOCKS));
    return true;
}

// requires that R be divisible by L
def check_blocks_per_row<R>(field[R] pixels, BlockLookup[R/L] lookups, field[B] blocks, field[R/L][L] baseB_decomps) -> bool {
    bool correct_blocks = true;

    u32 num_chunks = R/L;
    for u32 i in 0..num_chunks {
        field[L] expanded_chunk = [0; L];
        
        for u32 j in 0..L {
            expanded_chunk[j] = pixels[i*L + j];
        }

        field binary_chunk = pixels_to_binary(expanded_chunk);
        correct_blocks = correct_blocks && (binary_chunk == lookups[i].binary_enc);        
    }

    field[num_chunks] mut block_chunks = [0; num_chunks];
    field[num_chunks] mut all_nb = [0; num_chunks];
    field mut remainder = 0;
    field mut black_r = 0;
    for u32 i in 0..num_chunks {
        bool always_true = check_blocks_for_chunk(lookups[i]);

        field a = lookups[i].remainder_is_black;
        field b = black_r;
        field c = lookups[i].num_blocks_is_odd;
        field offset = 1 - a - b - c + 2*a*b + 2*a*c + 2*b*c - 4*a*b*c;
        field exp = lookups[i].num_blocks - offset;

        assert(value_in_array_tuple([exp, lookups[i].power_of_B], POWERS_OF_B));

        block_chunks[i] = remainder*lookups[i].power_of_B + lookups[i].baseB_enc;
        all_nb[i] = lookups[i].num_blocks + 1 - offset;

        remainder = lookups[i].remainder;
        black_r = lookups[i].remainder_is_black;
    }

    field beta = sample_challenge([...blocks, ...block_chunks, ...all_nb]);

    field mut result1 = 0;
    field mut pow = 1;
    for u32 b in 0..B {
        result1 = result1 + blocks[b] * pow;
        pow = pow * beta;
    }

    field[L] mut powers_of_beta = [1; L];
    for u32 i in 1..L {
        powers_of_beta[i] = powers_of_beta[i - 1] * beta;
    }


    bool mut correct_baseb_decomp = true;
    field mut result2 = 0;
    for u32 b in 0..num_chunks {
        // check that the baseB_decomp is legit
        field[L] baseB_decomp = baseB_decomps[b];
        field mut baseB_sum = 0;
        field b_f = u32_to_field(B);
        for u32 l in 0..L {
            baseB_sum = baseB_sum + baseB_decomp[l] * b_f**l;
        }
        correct_baseb_decomp = correct_baseb_decomp && (baseB_sum == block_chunks[b]);
        
        // compute the polynomial
        field mut sum = 0;
        for u32 l in 0..L {
            sum = sum + (baseB_decomp[l] * powers_of_beta[l]);
        }

        field to_add = if b > 1 {
            // TODO - this is a dynamic index into the powers_of_beta array. So that's an extra L constraints here. L isn't that big, put perhaps we can do better
            sum * powers_of_beta[all_nb[b - 1]]
        } else {
            sum
        };

        result2 = result2 + to_add;
    }
    
    return(correct_blocks && correct_baseb_decomp && (result1 == result2));
}

def check_blocks<R,C>(field[R][C] pixels, BlockLookup[R][C/L] lookups, field[R][B] blocks, field[R][C/L][L] baseB_decomps) -> bool {
    bool mut correct_blocks = true;
    for u32 r in 0..R {
        correct_blocks = correct_blocks && check_blocks_per_row(pixels[r], lookups[r], blocks[r], baseB_decomps[r]);
    }

    return(correct_blocks);
}

// test function
const u32 R = 3;
const u32 C = 80;

def main(field[R][C] pixels, private BlockLookup[R][C/L] lookups, field[R][B] blocks, field[R][C/L][L] baseB_decomps) {
    assert(check_blocks(pixels, lookups, blocks, baseB_decomps));
}
