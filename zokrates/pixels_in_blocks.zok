// Measure the length of blocks in pixels

from "./utils.zok" import check_bit_decomp;
from "EMBED" import value_in_array, value_in_array_tuple, sample_challenge, u32_to_field, unpack;

// The number of pixels to read from a row from the image at a time for lookup
const u32 L = 10;
const u32 TABLE_LEN = 1024; // 2^L

// base-B values representing a series of blocks
type Blocks = field;

// a positive integer
type NumBlocks = field;

struct BlockLookup {
    field binary_enc;

    Blocks baseB_enc;
    Blocks remainder;

    NumBlocks num_blocks;

    field num_blocks_is_odd;
    field remainder_is_black;

    field power_of_B;
}

// we already know the pixels are binary values, so just have to combine them
def pixels_to_binary<P>(field[P] pixels) -> field {
    field mut result = 0;
    for u32 i in 0..P {
        result = result + 2**i*pixels[i];
    }
    return(result);
}

def encode(BlockLookup lookup) -> field[6] {
    return([lookup.binary_enc, lookup.baseB_enc, lookup.remainder, lookup.num_blocks, lookup.num_blocks_is_odd, lookup.remainder_is_black]);
}

// requires that C be divisible by L
def check_chunks<C>(field[C] bin_pixels, BlockLookup[C/L] lookups, field[TABLE_LEN][6] table) -> bool {
    // Step 1 - Lookup
    bool mut correct_blocks = true;
    u32 num_chunks = C/L;
    for u32 i in 0..num_chunks {
        field[L] expanded_chunk = [0; L];
        
        for u32 j in 0..L {
            expanded_chunk[j] = bin_pixels[i*L + j];
        }

        field binary_chunk = pixels_to_binary(expanded_chunk); // this is no constraints because we already know the pixels are binary values
        // Ensure that the binary encoding of pixels found in the lookups is consistent with the binary image
        correct_blocks = correct_blocks && (binary_chunk == lookups[i].binary_enc);

        field[6] lookup_enc = encode(lookups[i]);
        assert(value_in_array_tuple(lookup_enc, table));
    }

    return(correct_blocks);
}

def process_chunks<C>(BlockLookup[C/L] lookups, field[L][2] powers_of_B) -> (field[C/L], field[C/L]) {
    u32 num_chunks = C/L;

    // Step 2 - Initialization
    field[num_chunks] mut block_chunks = [0; num_chunks];
    field[num_chunks] mut all_nb = [0; num_chunks];
    field mut remainder = 0;
    field mut black_r = 0;

    // Step 3 - Process chunks
    for u32 i in 0..num_chunks {
        field a = lookups[i].remainder_is_black;
        field b = black_r;
        field c = lookups[i].num_blocks_is_odd;
        field offset = 1 - a - b - c + 2*a*b + 2*a*c + 2*b*c - 4*a*b*c;
        field exp = lookups[i].num_blocks - offset;

        assert(value_in_array_tuple([exp, lookups[i].power_of_B], powers_of_B));

        block_chunks[i] = remainder*lookups[i].power_of_B + lookups[i].baseB_enc;
        all_nb[i] = lookups[i].num_blocks + 1 - offset;

        remainder = lookups[i].remainder;
        black_r = lookups[i].remainder_is_black;
    }

    return((block_chunks, all_nb));

}

def power_from_bit_decomp<B,LOGM>(field[B] powers_of_beta, field exponent) -> field {
    bool[LOGM] bits = unpack(exponent);
    assert(check_bit_decomp(exponent, bits));

    field mut result = 1;
    for u32 i in 0..LOGM {
        u32 ind = LOGM - i - 1;
        field to_mult = if (bits[ind]) {
            powers_of_beta[ind]
        } else {
            1
        };

        result = result * to_mult;
    }

    return(result);
}

def check_consistency<C,B,M,LOGM>(field[B] powers_of_beta, field[B] blocks, field[C/L] block_chunks, field[C/L] all_nb, field[R/L][M] baseB_decomps, field[B] range_check_table) -> bool {
    u32 num_chunks = C/L;

    field mut result_f = 0;
    for u32 b in 0..B {
        result_f = result_f + blocks[b] * powers_of_beta[b];
    }

    bool mut correct_baseb_decomp = true;
    field mut outer_power = 1;
    field mut result_g = 0;
    for u32 i in 0..num_chunks {
        // check that the baseB_decomp is legit
        field[L] baseB_decomp = baseB_decomps[i];
        field mut baseB_sum = 0;
        field b_f = u32_to_field(B);
        for u32 j in 0..M {
            baseB_sum = baseB_sum + baseB_decomp[i] * b_f**j;
            assert(value_in_array(baseB_decomp[i], range_check_table));
        }
        correct_baseb_decomp = correct_baseb_decomp && (baseB_sum == block_chunks[i]);
        
        // compute the polynomial
        field mut sum = 0;
        for u32 j in 0..M {
            sum = sum + (baseB_decomp[j] * powers_of_beta[j]);
        }


        field to_mult = if i > 0 {
            power_from_bit_decomp::<B,LOGM>(powers_of_beta, all_nb[i-1])
        } else {
            1
        };
        outer_power = outer_power * to_mult;

        result_g = result_g + sum * outer_power;
    }
    
    return(result_f == result_g);
}

def check_blocks<R,C,B,M,LOGM>(field[R][C] bin_pixels, BlockLookup[R][C/L] lookups, field[TABLE_LEN][6] chunk_lookup_table, field[L][2] powers_of_B, field[R][B] blocks, field[R][C/L][L] baseB_decomps, field[B] range_check_table) -> bool {
    u32 num_chunks = C/L;
    bool mut correct_chunks = true;

    // lookup and process all chunks
    field[R][num_chunks] mut block_chunks = [ [0; num_chunks]; R];
    field[R*num_chunks] mut flattened_block_chunks = [0; R*num_chunks];
    field[R][num_chunks] mut all_nb = [ [0; num_chunks]; R];
    field[R*num_chunks] mut flattened_all_nb = [0; R*num_chunks];
    for u32 r in 0..R {
        correct_chunks = correct_chunks && check_chunks(bin_pixels[r], lookups[r], chunk_lookup_table);

        (field[num_chunks], field[num_chunks]) processed = process_chunks(lookups[r], powers_of_B);
        block_chunks[r] = processed.0;
        all_nb[r] = processed.1;

        for u32 c in 0..num_chunks {
            flattened_block_chunks[r*num_chunks + c] = block_chunks[r][c];
            flattened_all_nb[r*num_chunks + c] = all_nb[r][c];
        }
    }

    // get a verifier challenge
    field[R*B] flattened_blocks = [0; R*B];
    for u32 r in 0..R {
        for u32 b in 0..B {
            flattened_blocks[r*B + b] = blocks[r][b];
        }
    }
    field beta = sample_challenge([...flattened_blocks, ...flattened_block_chunks, ...flattened_all_nb]);

    field[B] mut powers_of_beta = [1; B];
    for u32 b in 1..B {
        powers_of_beta[b] = powers_of_beta[b-1] * beta;
    }

    // check consistency of all rows using that verifier challenge
    bool mut consistent = true;
    for u32 r in 0..R {
        consistent = consistent && check_consistency::<C,B,M,LOGM>(powers_of_beta, blocks[r], block_chunks[r], all_nb[r], baseB_decomps[r], range_check_table);
    }

    return(correct_chunks && consistent);
}
