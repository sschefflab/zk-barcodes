from "./make_words.zok" import compute_words;
from "./block_measurement_const.zok" import WB_NB, G_NB, WB_CW, G_CW;

const u32 R = 36;

def main(
    private field[R][WB_NB] wb_blocks,
    private field[R][WB_CW][8] wb_normalized_blocks,
    field[R][WB_CW] wb_words,
    private field[R][G_NB] g_blocks,
    private field[R][G_CW][8] g_normalized_blocks,
    field[R][G_CW] garbage_words
) {
    field[R][WB_CW] computed_words = compute_words(wb_blocks, wb_normalized_blocks);
    field[R][G_CW] computed_garbage = compute_words(g_blocks, g_normalized_blocks);

    for u32 r in 0..R {
        for u32 c in 0..WB_CW {
            assert(computed_words[r][c] == wb_words[r][c]);
        }

        for u32 c in 0..G_CW {
            assert(computed_garbage[r][c] == garbage_words[r][c]);
        }
    }
}
