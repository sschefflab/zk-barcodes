// Utility functions and common values used throughout the zokrates code.

from "EMBED" import unpack, value_in_array;
from "./const_range_check.zok" import RANGE_0_512;

// 919 is "reserved in the pdf417 spec and currently has no use.
// We can use it as a valid field element that has no meaning.
// Row indicators can also never take this value - they are always on the range [0, 899]
const field DUMMY_CODEWORD = 919;

// 900 is a pad codeword and should not be interpreted as a character
const field PAD_CODEWORD = 900;

// MSB to LSB
def check_bit_decomp<B>(field v, bool[B] bits) -> bool {
    field mut sum = 0;
    
    for u32 i in 0..B {
        field field_bit = bits[i] ? 1 : 0;
        sum = sum + 2**(B - i - 1)*field_bit;
    }

    return(sum == v);
}

def gt_9bit(field a, field b) -> bool {
    field diff = a - b;
    assert(value_in_array(diff, RANGE_0_512[1..512]));
}
