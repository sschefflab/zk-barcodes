// this has 3719 setup constraints just to make the lookup tables
def lookup_codeword(field pattern, field codeword) -> bool {
    assert(value_in_array(codeword, GF_929));
    field encoded_pair = pattern*929 + codeword;
    assert(value_in_array(encoded_pair, ENCODED_PAIRS));
    return(true);
}

// test function

def main(private field pattern, private field codeword) -> bool {
    return(lookup_codeword(pattern, codeword));
}

