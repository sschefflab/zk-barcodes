from "./binarize.zok" import binarize;
from "./make_words.zok" import compute_words;
from "./make_codewords.zok" import compute_codewords;
from "./error_correction.zok" import BarcodeStats, RowIndicatorVars, check_barcode_stats, check_barcode_size, check_error_correction;
from "./codewords_to_chars.zok" import codewords_to_chars;

//TODO: fill in with more reasonable constants
const u32 N = 32; // image size
const u32 D = 16; // number of blocks
const u32 W = 2; // number of words

def main(private field[N] image,
         private bool[N] bin_image,
         private bool[N] transitions,
         private field[D] counts,
         private field[W][8] normalized_blocks,
         private field[W] words_with_dummies,
         private field[W] corrected_codewords,
         private BarcodeStats stats,
         private RowIndicatorVars row_indc,
         private field[2*W] base30_chars
) -> u8[2*W]
{
    assert(binarize(image, bin_image)); // this function always returns true, but it does asserts inside

    field[W] words = compute_words(bin_image, transitions, counts, normalized_blocks);
    field[W] codewords = compute_codewords(words, words_with_dummies);

    assert(check_barcode_stats(row_indc, stats));
    assert(check_error_correction(codewords, corrected_codewords, stats.ec_level));
    assert(check_barcode_size(corrected_codewords, stats.num_rows, stats.num_cols));

    u8[2*W] chars = codewords_to_chars(corrected_codewords, base30_chars);
    return(chars);
}
