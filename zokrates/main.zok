from "./binarize.zok" import binarize;
from "./make_words.zok" import compute_words;
from "./make_codewords.zok" import check_codewords;
from "./error_correction.zok" import BarcodeStats, RowIndicatorVars, PolynomialResult, check_barcode_stats, check_error_correction;
from "./data_size.zok" import check_num_cw;
from "./char_lookup.zok" import TableState;
from "./codewords_to_chars.zok" import codewords_to_chars;
from "hashes/sha256/sha256" import main as sha256;
from "EMBED" import u32_to_field;

//TODO: fill in with more reasonable constants
const u32 R = 2; // number of rows of pixels
const u32 CP = 48; // length of rows in pixels
const u32 N = R * CP;
const u32 CW = 6; // length of rows in "words" (groups of 8 blocks)
const u32 W = 2; // number of words
const u32 SHA_OUTPUT_SIZE = 8; // SHA256 output size (8 words = 256 bits)
const u32 SHA_BLOCK_SIZE = 16; // SHA256 words per block (512 bits / 32 bits)
const u32 SHA_NUM_BLOCKS = N / SHA_BLOCK_SIZE; // number of SHA256 blocks needed

//TODO: we will need some more inputs for pixels-to-blocks code, but that is TBD
def main(u32[SHA_OUTPUT_SIZE] image_digest,
         private field[R][CP] image,
         private u32[SHA_NUM_BLOCKS][SHA_BLOCK_SIZE] image_u32,
         private field[R][CP] bin_image,
         private field[R][CW][8] normalized_blocks,
         private field[R][CW] words_with_dummies,
         private field[R][CW] ext_codewords,
         private field[W] codewords,
         private field[R] left_row_inds,
         private RowIndicatorVars row_indc,
         private field[W] corrected_codewords,
         private PolynomialResult[512] poly_witness,
         private BarcodeStats stats,
         private TableState[2*W] char_table_states
) -> field[2*W]
{
    // TODO: replace with whatever we end up using for the digest
    // This SHA256 stuff adds 57,508 constraints when uncommented.
    // Verify that image_u32 correctly represents image
    for u32 i in 0..N {
        u32 block = i / SHA_BLOCK_SIZE;
        u32 word = i % SHA_BLOCK_SIZE;
        assert(image[i] == u32_to_field(image_u32[block][word]));
    }

    // Compute SHA256 hash of the image and verify it matches the public digest
    u32[SHA_OUTPUT_SIZE] computed_digest = sha256::<SHA_NUM_BLOCKS>(image_u32);
    assert(computed_digest == image_digest);

    assert(binarize(image, bin_image));

    field[R][CW] words = compute_words(bin_image, transitions, counts, normalized_blocks); // 3.4k constraints
    assert(check_codewords(words, words_with_dummies, ext_codewords, codewords, left_row_inds)); // 3.8k constraints (mostly lookup table setup)

    assert(check_barcode_stats(row_indc, stats, left_row_inds));
    assert(check_error_correction(codewords, corrected_codewords, stats.ec_level, poly_witness));

    assert(check_num_cw(corrected_codewords, stats.num_rows, stats.num_cols, stats.ec_level));

    field[2*W] chars = codewords_to_chars(corrected_codewords, char_table_states, stats.ec_level); // 340 constraints
    return(chars);
}
