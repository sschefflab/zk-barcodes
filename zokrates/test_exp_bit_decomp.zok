from "EMBED" import unpack;

const u32 N = 3;

def main(field x, private field[N] alphas) -> field[N] {
    field[4] mut powers_of_x = [1; 4];
    for u32 i in 1..4 {
        powers_of_x[i] = x * powers_of_x[i-1];
    }

    field[N] mut results = [1; N];
    for u32 i in 0..N {
        bool[4] alpha_bits = unpack(alphas[i]);

        for u32 j in 1..4 {
            field to_mult = if alpha_bits[j] {
                powers_of_x[j]
            } else {
                 1
            };

            results[i] = results[i] * to_mult;
        }
    }

    return(results);
}

