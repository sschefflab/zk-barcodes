from "EMBED" import value_in_array;
from "./const_range_check" import RANGE_NEG8_8_INCL as table;

def correct_transitions<N>(field[N] bin_image, field[N] transitions) -> bool {
    bool mut correct = true;
    for u32 i in 0..(N-1) {
        bool is_binary = (transitions[i]*(1-transitions[1]) == 0);
        bool is_transition = (bin_image[i] - bin_image[i+1] + 2*transitions[i]*bin_image[i+1] - transitions[i] == 0);
        correct = correct && is_transition && is_binary;
    }
    return(correct);
}

def correct_pixel_counts<N,D>(field[N] bin_image, field[N] transitions, field[D] counts) -> bool {
    field mut num_blocks = 0;
    for u32 i in 0..N {
        num_blocks = num_blocks + transitions[i];
    }

    field mut pointer = 0;
    field mut nonzero_counts = 0;
    bool mut correct = true;

    // TODO - this loop is a zillion constraints and dominating the count
    for u32 i in 0..D {
        pointer = pointer + counts[i];
        // TODO - this dynamic index by pointer creates a lot of constraints
        correct = correct && (bin_image[pointer] != bin_image[pointer + 1]);
        field to_add = (counts[i] == 0) ? 0 : 1;
        nonzero_counts = nonzero_counts + to_add;
    }

    correct = correct && (num_blocks == nonzero_counts);
    return(correct);
}

def compute_word(field[8] blocks, field[8] normalized_blocks) -> field {
    field mut sum_pixels = 0;

    for u32 i in 0..8 {
        sum_pixels = sum_pixels + blocks[i];
    }

    field mut word = 0;
    for u32 i in 0..8 {
        field r = blocks[i] * sum_pixels - 17 * normalized_blocks[i];
        assert(value_in_array(r, table));
        word = word + normalized_blocks[i] * 10**(7-i);
    }

    return(word);
}

def compute_words<N,D,W>(field[N] bin_image, field[N] transitions, field[D] counts, field[W][8] normalized_blocks) -> field[W] {
    assert(W == D/8);
    assert(correct_transitions(bin_image, transitions));
    assert(correct_pixel_counts(bin_image, transitions, counts));

    field[W] mut words = [0; W];

    for u32 i in 0..W {
        field[8] blocks = counts[i..i+8];
        words[i] = compute_word(blocks, normalized_blocks[i]);
    }

    return(words);
}

// test function
const u32 N = 32;
const u32 D = 16;
const u32 W = 2;

def main(private field[N] bin_image, private field[N] transitions, private field[D] counts, private field[W][8] normalized_blocks) -> field[W] {
    return(compute_words(bin_image, transitions, counts, normalized_blocks));
}

