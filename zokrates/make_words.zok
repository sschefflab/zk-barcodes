// Compute "words" (bsbsbsbs units represented as one field element) from blocks.
// Normalize blocks, and then combined the normalized blocks into one.

from "EMBED" import value_in_array;
from "./const_range_check" import RANGE_NEG16_16_INCL as pair_table;


def compute_word(field[8] blocks, field[8] normalized_blocks) -> field {
    field mut sum_pixels = 0;
    for u32 i in 0..8 {
        sum_pixels = sum_pixels + blocks[i];
    }

    // Check 6 edge-to-similar-edge pair residuals (ISO 15438 Annex J.3).
    // Pairing adjacent bars cancels edge-position noise: if a bar/space boundary
    // is detected half a pixel late, one element grows and its neighbor shrinks
    // by the same amount, so the pair sum is unaffected.
    // Individual range validity is enforced downstream by the word lookup.
    for u32 i in 0..6 {
        field r = (blocks[i] + blocks[i+1]) * 17 - sum_pixels * (normalized_blocks[i] + normalized_blocks[i+1]);
        assert(value_in_array(r, pair_table));
    }

    field mut word = 0;
    for u32 i in 0..8 {
        word = word + normalized_blocks[i] * 10**(7-i);
    }

    return(word);
}

def compute_words_per_row<NB,CW>(field[NB] blocks, field[CW][8] normalized_blocks) -> field[CW] {
    field[CW][8] mut grouped_blocks = [[0; 8]; CW];
    for u32 i in 0..CW {
        for u32 j in 0..8 {
            field grouped_block = if (8*(i+1) > NB) { // if this chunk is partial, zero it out
                0
            } else {
                blocks[8*i + j]
            };
            grouped_blocks[i][j] = grouped_block;
        }
    }

    field[CW] mut words = [0; CW];
    for u32 i in 0..CW {
        words[i] = compute_word(grouped_blocks[i], normalized_blocks[i]);
    }

    return(words);
}

def compute_words<R,NB,CW>(field[R][NB] blocks, field[R][CW][8] normalized_blocks) -> field[R][CW] {
    field[R][CW] mut words = [[0; CW]; R];
    for u32 r in 0..R {
        words[r] = compute_words_per_row(blocks[r], normalized_blocks[r]);
    }
    return(words);
}

// test function
const u32 R = 89;
const u32 NB = 1080;
const u32 CW = 135;

def main(private field[R][NB] blocks, private field[R][CW][8] normalized_blocks) -> field[R][CW] {
    return(compute_words(blocks, normalized_blocks));
}
