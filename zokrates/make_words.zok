from "EMBED" import value_in_array;
from "./utils.zok" import L, B;
from "./const_range_check" import RANGE_NEG8_8_INCL as table;


def compute_word(field[8] blocks, field[8] normalized_blocks) -> field {
    field mut sum_pixels = 0;
    for u32 i in 0..8 {
        sum_pixels = sum_pixels + blocks[i];
    }

    field mut word = 0;
    for u32 i in 0..8 {
        field r = blocks[i] * sum_pixels - 17 * normalized_blocks[i];
        assert(value_in_array(r, table));
        word = word + normalized_blocks[i] * 10**(7-i);
    }

    return(word);
}

def compute_words_per_row<CW>(field[B] blocks, field[CW][8] normalized_blocks) -> field[CW] {
    field[CW][8] mut grouped_blocks = [[0; 8]; CW];
    for u32 i in 0..CW {
        for u32 j in 0..8 {
            grouped_blocks[i][j] = blocks[CW*i + j];
        }
    }

    bool extra_blocks_are_zero = true;
    for u32 i in CW*8..B {
        extra_blocks_are_zero = extra_blocks_are_zero && (blocks[i] == 0);
    }
    assert(extra_blocks_are_zero);

    field[CW] mut words = [0; CW];
    for u32 i in 0..CW {
        words[i] = compute_word(grouped_blocks[i], normalized_blocks[i]);
    }

    return(words);
}

def compute_words<R,CW>(field[R][B] blocks, field[R][CW][8] normalized_blocks) -> field[R][CW] {
    field[R][CW] mut words = [[0; CW]; R];
    for u32 r in 0..R {
        words[r] = compute_words_per_row(blocks[r], normalized_blocks[r]);
    }
    return(words);
}

// test function
const u32 R = 3;
const u32 CW = 10;

def main(private field[R][B] blocks, private field[R][CW][8] normalized_blocks) -> field[R][CW] {
    return(compute_words(blocks, normalized_blocks));
}
