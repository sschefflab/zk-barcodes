// Compute "words" (bsbsbsbs units represented as one field element) from blocks.
// Normalize blocks, and then combined the normalized blocks into one.

from "./utils.zok" import diff_lookup;
from "./const_range_check.zok" import RANGE_0_432;

def compute_word<WW>(field[8] blocks, field[6] normalized_widths, field[2*WW] block_width_lookup) -> field {
    bool mut zero_block = false;
    field mut pixel_total = 0;
    for u32 i in 0..8 {
        zero_block = zero_block || (blocks[i] == 0);
        pixel_total = pixel_total + blocks[i];
    }

    field[6] mut widths = [0; 6];
    for u32 i in 1..7 {
        widths[i-1] = blocks[i] + blocks[i-1];
    }

    for u32 i in 0..6 {
        assert(!zero_block || normalized_widths[i] == 0);

        field middle = 34*widths[i];

        field lower_bound = if (zero_block) {
            middle - 1 // dummy: always satisfies middle > lower_bound
        } else {
            pixel_total*(2*normalized_widths[i] - 1)
        };

        field upper_bound = if (zero_block) {
            middle + 1 // dummy: always satisfies middle <= upper_bound
        } else {
            pixel_total*(2*normalized_widths[i] + 1)
        };

        // lower_bound <= middle < upper_bound
        // diff_lookup always returns true, but it does an assert inside
        bool is_true1 = diff_lookup(middle, lower_bound, block_width_lookup);
        bool is_true2 = diff_lookup(upper_bound, middle, block_width_lookup[1..]);
    }
    
    field mut word = 0;
    // The largest possible width is 12, so we encode base-13
    for u32 i in 0..6 {
        word = word + normalized_widths[i] * 13**i;
    }

    return(word);
}

def compute_words_per_row<WW,NB,CW>(field[NB] blocks, field[CW][6] normalized_widths, field[2*WW] lookup) -> field[CW] {
    field[CW][8] mut grouped_blocks = [[0; 8]; CW]; // still 8 raw blocks per word
    for u32 i in 0..CW {
        for u32 j in 0..8 {
            field grouped_block = if (8*(i+1) > NB) { // if this chunk is partial, zero it out
                0
            } else {
                blocks[8*i + j]
            };
            grouped_blocks[i][j] = grouped_block;
        }
    }

    field[CW] mut words = [0; CW];
    for u32 i in 0..CW {
        words[i] = compute_word::<WW>(grouped_blocks[i], normalized_widths[i], lookup);
    }

    return(words);
}

def compute_words<R, WW, NB,CW>(field[R][NB] blocks, field[R][CW][6] normalized_widths, field[2*WW] lookup) -> field[R][CW] {
    field[R][CW] mut words = [[0; CW]; R];
    for u32 r in 0..R {
        words[r] = compute_words_per_row::<WW,NB,CW>(blocks[r], normalized_widths[r], lookup);
    }
    return(words);
}

// test function
const u32 R = 32;
const u32 WW = 216;
const u32 NB = 273;
const u32 CW = 35;

def main(private field[R][NB] blocks, private field[R][CW][6] normalized_widths) -> field[R][CW] {
    return(compute_words::<R,WW,NB,CW>(blocks, normalized_widths, RANGE_0_432));
}
