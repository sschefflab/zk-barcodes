from "EMBED" import value_in_array;
from "./const_range_check" import RANGE_NEG8_8_INCL as table;

def bool_to_field(bool b) -> field {
    return(b ? 1 : 0);
}

def correct_transitions<N>(bool[N] bin_image, bool[N] transitions) -> bool {
    bool mut correct = true;
    for u32 i in 0..(N-1) {
        field p_i = bool_to_field(bin_image[i]);
        field p_i1 = bool_to_field(bin_image[i+1]);
        field t_i = bool_to_field(transitions[i]);
        correct = correct && (p_i - p_i1 + 2*t_i*p_i1 - t_i == 0);
    }
    return(correct);
}

def correct_pixel_counts<N,D>(bool[N] bin_image, bool[N] transitions, field[D] counts) -> bool {
    field mut num_blocks = 0;
    for u32 i in 0..N {
        num_blocks = num_blocks + bool_to_field(transitions[i]);
    }

    field mut pointer = 0;
    field mut nonzero_counts = 0;
    bool mut correct = true;

    for u32 i in 0..D {
        pointer = pointer + counts[i];
        correct = correct && (bin_image[pointer] != bin_image[pointer + 1]);
        field to_add = (counts[i] == 0) ? 0 : 1;
        nonzero_counts = nonzero_counts + to_add;
    }

    correct = correct && (num_blocks == nonzero_counts);
    return(correct);
}

def compute_word(field[8] blocks, field[8] normalized_blocks) -> field {
    field mut sum_pixels = 0;

    for u32 i in 0..8 {
        sum_pixels = sum_pixels + blocks[i];
    }

    field mut word = 0;
    for u32 i in 0..8 {
        field r = blocks[i] * sum_pixels - 17 * normalized_blocks[i];
        assert(value_in_array(r, table));
        word = word + normalized_blocks[i] * 10**(7-i);
    }

    return(word);
}

def compute_words<N,D,W>(bool[N] bin_image, bool[N] transitions, field[D] counts, field[W][8] normalized_blocks) -> field[W] {
    assert(W == D/8);
    assert(correct_transitions(bin_image, transitions));
    assert(correct_pixel_counts(bin_image, transitions, counts));

    field[W] mut words = [0; W];

    for u32 i in 0..W {
        field[8] blocks = counts[i..i+8];
        words[i] = compute_word(blocks, normalized_blocks[i]);
    }

    return(words);
}

// test function
const u32 N = 64;
const u32 D = 16;
const u32 W = 2;

def main(private bool[N] bin_image, private bool[N] transitions, private field[D] counts, private field[W][8] normalized_blocks) -> field[W] {
    return(compute_words(bin_image, transitions, counts, normalized_blocks));
}
