const u32 L_SD = 10;
const u32 TABLE_LEN_SD = 1024; // 2^L

const u32 WB_B_SD = 65; // ceil(640 / 85) * 8 + 1
const u32 WB_NB_SD = 273; // same as HD
const u32 WB_M_SD = 5; // max blocks per chunk = ceil(10/(640/273))
const u32 WB_LOGM_SD = 3; // ceil(log2(WB_M_SD))
const u32 WB_CW_SD = 35; // same as HD - property of pdf417 barcode

const u32 G_B_SD = 641;
const u32 G_NB_SD = 640; // B - 1
const u32 G_M_SD = 10; // same as L
const u32 G_LOGM_SD = 4; // ceil(log2(G_M_SD))
