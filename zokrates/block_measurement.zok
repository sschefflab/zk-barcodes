// Measure the length of blocks in pixels

from "./utils.zok" import check_bit_decomp, flatten_array, diff_lookup;
from "./const_range_check.zok" import RANGE_1_513, RANGE_0_105, RANGE_0_1081;
from "EMBED" import value_in_array, value_in_array_tuple, sample_challenge, u32_to_field, unpack;
from "./block_measurement_const.zok" import L, TABLE_LEN, WB_B, WB_NB, WB_M, WB_LOGM, WB_POWERS_OF_B, WB_CHUNK_LOOKUP_TABLE, G_B, G_NB, G_M, G_LOGM, G_POWERS_OF_B, G_CHUNK_LOOKUP_TABLE;

// base-B values representing a series of blocks
type Blocks = field;

// a positive integer
type NumBlocks = field;

struct BlockLookup {
    field binary_enc;

    Blocks baseB_enc;
    Blocks remainder;

    NumBlocks num_blocks;

    field num_blocks_is_odd;
    field remainder_is_black;

    field next_power_of_B;
}

// we already know the pixels are binary values, so just have to combine them
def pixels_to_binary<P>(field[P] pixels) -> field {
    field mut result = 0;
    for u32 i in 0..P {
        result = result + 2**i*pixels[i];
    }
    return(result);
}

def encode(BlockLookup lookup) -> field[6] {
    return([lookup.binary_enc, lookup.baseB_enc, lookup.remainder, lookup.num_blocks, lookup.num_blocks_is_odd, lookup.remainder_is_black]);
}

// requires that C be divisible by L
def check_chunks<C,L,TABLE_LEN>(
    field[C] bin_pixels,
    BlockLookup[C/L] lookups,
    field[TABLE_LEN][6] table
) -> bool {
    // Step 1 - Lookup
    bool mut correct_blocks = true;
    u32 num_chunks = C/L;
    for u32 i in 0..num_chunks {
        field[L] expanded_chunk = [0; L];
        
        for u32 j in 0..L {
            expanded_chunk[j] = bin_pixels[i*L + j];
        }

        field binary_chunk = pixels_to_binary(expanded_chunk); // this is no constraints because we already know the pixels are binary values
        // Ensure that the binary encoding of pixels found in the lookups is consistent with the binary image
        correct_blocks = correct_blocks && (binary_chunk == lookups[i].binary_enc);

        field[6] lookup_enc = encode(lookups[i]);
        assert(value_in_array_tuple(lookup_enc, table));
    }

    return(correct_blocks);
}

struct ProcessedChunks<C,L> {
    field[C/L] block_chunks;
    field[C/L] all_nb;
}

def process_chunks<C,L,M>(
    BlockLookup[C/L] lookups,
    field[M][2] powers_of_B
) -> ProcessedChunks<C,L> {
    u32 num_chunks = C/L;

    // Step 2 - Initialization
    field[num_chunks] mut block_chunks = [0; num_chunks];
    field[num_chunks] mut all_nb = [0; num_chunks];
    field mut remainder = 0;
    field mut black_r = 0;

    // Step 3a - Process chunk 0: no previous remainder, so no extra_block offset
    block_chunks[0] = lookups[0].baseB_enc;
    all_nb[0] = lookups[0].num_blocks;
    remainder = lookups[0].remainder;
    black_r = lookups[0].remainder_is_black;

    // Step 3b - Process remaining chunks
    for u32 i in 1..num_chunks {
        // only used in the non-zero case, but zokrates is weird and I have to declare this out here
        field a = lookups[i].remainder_is_black;
        field b = black_r;
        field c = lookups[i].num_blocks_is_odd;
        field extra_block = a + b + c - 2*a*b - 2*a*c - 2*b*c + 4*a*b*c;
        field power_of_B = if (extra_block == 0) {
            1
        } else {
            powers_of_B[1][1]
        };

        // block_chunk, nb, remainder, remainder_is_black
        (field, field, field, field) combined = if (lookups[i].num_blocks == 0) {
            // This is gross, but all these values have to be inlined because no values can be declared inside an if statement
            if ((lookups[i].remainder_is_black == 1 && black_r == 1) || (lookups[i].remainder_is_black == 0 && black_r == 0)) {
                (0, 0, remainder + lookups[i].remainder, black_r)
            } else {
                (remainder, 1, lookups[i].remainder, lookups[i].remainder_is_black)
            }
        } else {
            (remainder+power_of_B*lookups[i].baseB_enc, lookups[i].num_blocks + extra_block, lookups[i].remainder, lookups[i].remainder_is_black)
        };

        block_chunks[i] = combined.0;
        all_nb[i] = combined.1;

        remainder = combined.2;
        black_r = combined.3;
    }

    // Handle the last remainder
    u32 last = num_chunks - 1;
    assert(value_in_array_tuple([all_nb[last], lookups[last].next_power_of_B], powers_of_B));
    block_chunks[last] = block_chunks[last] + remainder * lookups[last].next_power_of_B;
    all_nb[last] = all_nb[last] + 1;


    ProcessedChunks<C,L> result = ProcessedChunks { block_chunks : block_chunks, all_nb : all_nb };
    return(result);

}

def make_binary_powers<LOGM>(
    field beta
) -> field[LOGM] {
    field[LOGM] result = [beta; LOGM];
    for u32 i in 1..LOGM {
        result[i] = result[i-1] * result[i-1];
    }
    return(result);
}

def power_from_bit_decomp<LOGM>(
    field beta,
    field exponent
) -> field {
    bool[LOGM] bits = unpack(exponent);
    assert(check_bit_decomp(exponent, bits));

    field[LOGM] binary_powers = make_binary_powers(beta);

    field mut result = 1;
    for u32 i in 0..LOGM {
        u32 pwr = LOGM - i - 1;
        field to_mult = if (bits[i]) {
            binary_powers[pwr]
        } else {
            1
        };

        result = result * to_mult;
    }

    return(result);
}

def check_consistency<C,L,B,NB,M,LOGM>(
    field[NB] blocks,
    field[C/L] block_chunks,
    field[C/L] all_nb,
    field[C/L][M] baseB_decomps,
    field[B] range_check_table
) -> bool {
    u32 num_chunks = C/L;

    field beta = sample_challenge([...blocks, ...block_chunks, ...all_nb]);
    field[NB] mut powers_of_beta = [1; NB];
    for u32 b in 1..NB {
        powers_of_beta[b] = powers_of_beta[b-1] * beta;
    }

    field mut result_f = 0;
    for u32 b in 0..NB {
        result_f = result_f + blocks[b] * powers_of_beta[b];
    }

    bool mut correct_baseb_decomp = true;
    field mut outer_power = 1;
    field mut result_g = 0;
    for u32 i in 0..num_chunks {

        // check that the baseB_decomp is legit
        field[L] baseB_decomp = baseB_decomps[i];
        field mut baseB_sum = 0;
        field b_f = u32_to_field(B);
        for u32 j in 0..M {
            baseB_sum = baseB_sum + baseB_decomp[j] * b_f**j;
            assert(value_in_array(baseB_decomp[j], range_check_table));
        }
        correct_baseb_decomp = correct_baseb_decomp && (baseB_sum == block_chunks[i]);
        
        // compute the polynomial
        field mut sum = 0;
        for u32 j in 0..M {
            sum = sum + (baseB_decomp[j] * powers_of_beta[j]);
        }

        result_g = result_g + sum * outer_power;
        outer_power = outer_power * power_from_bit_decomp::<LOGM>(beta, all_nb[i]);
    }

    return(result_f == result_g && correct_baseb_decomp);
}

def check_blocks<R,C,L,TABLE_LEN,B,NB,M,LOGM>(
    field[R][C] bin_pixels,
    BlockLookup[R][C/L] lookups,
    field[TABLE_LEN][6] chunk_lookup_table,
    field[M][2] powers_of_B,
    field[R][NB] blocks,
    field[R][C/L][L] baseB_decomps,
    field[B] range_check_table
) -> bool {
    u32 num_chunks = C/L;
    bool mut correct_chunks = true;

    // lookup and process all chunks
    field[R][num_chunks] mut block_chunks = [ [0; num_chunks]; R];
    field[R][num_chunks] mut all_nb = [ [0; num_chunks]; R];
    for u32 r in 0..R {
        correct_chunks = correct_chunks && check_chunks(bin_pixels[r], lookups[r], chunk_lookup_table);

        ProcessedChunks<C,L> processed = process_chunks::<C,L,M>(lookups[r], powers_of_B);
        block_chunks[r] = processed.block_chunks;
        all_nb[r] = processed.all_nb;
    }

    // check consistency of all rows, each generating its own verifier challenge
    bool mut consistent = true;
    for u32 r in 0..R {
        consistent = consistent && check_consistency::<C,L,B,NB,M,LOGM>(blocks[r], block_chunks[r], all_nb[r], baseB_decomps[r], range_check_table);
    }

    return(correct_chunks && consistent);
}

// always returns true, but does an assert inside
def non_decreasing_array_9bit<A>(field[A] arr) -> bool {
    for u32 i in 1..A {
        bool is_true = diff_lookup(arr[i], arr[i-1], [0, ...RANGE_1_513]); // always returns true, but does an assert inside
    }

    return(true);
}

def combine_bits<B>(field[B] bits) -> field {
    field mut sum = 0;

    for u32 b in 0..B {
        sum = sum + bits[b] * 2**b;
    }

    return(sum);
}

def combine_rows<R,C>(field[R][C] arr, field gamma) -> field[R] {
    field[R] mut result = [0; R];
    u32 maxC = if (C % 100 == 0) {
        C / 100
    } else {
        C / 100 + 1
    };
    
    for u32 r in 0..R {
        field mut sum = 0;
        for u32 c in 0..maxC {
            u32 starting_ind = c*100;
            u32 ending_ind = if (starting_ind + 100 < C) {
                starting_ind + 100
            } else {
                C
            };
            
            field comb1 = combine_bits(arr[r][c*100..ending_ind]);
            sum = sum + comb1 * gamma**c;
        }

        result[r] = sum;
    }

    return(result);
}

def check_garbage_split<R,C,G_R>(
    field[R][C] bin_pixels,
    field[R][C] well_behaved,
    field[R] wb_inds,
    field[R] wb_ind_counts,
    field[G_R][C] garbage,
    field[G_R] garbage_inds,
    field num_zero_rows
) -> bool {
    bool is_true = non_decreasing_array_9bit(wb_inds); // this output is always true, but it does asserts inside

    // combine rows into single field elements
    field[R*C] flattened_bin_img = flatten_array(bin_pixels);
    field[R*C] flattened_wb = flatten_array(well_behaved);
    field[G_R*C] flattened_garbage = flatten_array(garbage);
    field gamma = sample_challenge([...flattened_bin_img, ...flattened_wb, ...flattened_garbage]);

    field[R] bin_img_rows = combine_rows(bin_pixels, gamma);
    field[R] wb_rows = combine_rows(well_behaved, gamma);
    field[G_R] garbage_rows = combine_rows(garbage, gamma);

    // Haboeck argument
    field alpha = sample_challenge([...bin_img_rows, ...wb_rows, ...garbage_rows]);
    field beta = sample_challenge([...bin_img_rows, ...wb_rows, ...garbage_rows]);

    field mut lhs = num_zero_rows / (alpha - 1);
    field mut rhs = 0;

    for u32 i in 0..R {
        field i_f = u32_to_field(i);
        field term = wb_ind_counts[i] / (alpha + i_f + beta * bin_img_rows[i]);
        lhs = lhs + term;
    }

    for u32 j in 0..R {
        field term = 1 / (alpha + wb_inds[j] + beta * wb_rows[j]);
        rhs = rhs + term;
    }

    for u32 k in 0..G_R {
        field term = 1 / (alpha + garbage_inds[k] + beta * garbage_rows[k]);
        rhs = rhs + term;
    }

    return(lhs == rhs);
}

def block_measurement<R,C,L,TABLE_LEN,G_R, WB_B, WB_NB, WB_M, WB_LOGM, G_B, G_NB, G_M, G_LOGM>(
    // The full binary image and the split into well-behaved / garbage rows
    field[R][C] bin_image,
    field[R][C] well_behaved,
    field[R] wb_inds,
    field[R] wb_ind_counts,
    field[G_R][C] garbage,
    field[G_R] garbage_inds,
    field num_zero_rows,
    // Well-behaved block checking metadata
    BlockLookup[R][C/L] wb_lookups,
    field[R][WB_NB] wb_blocks,
    field[R][C/L][L] wb_baseB_decomps,
    // Garbage block checking metadata
    BlockLookup[G_R][C/L] g_lookups,
    field[G_R][G_NB] g_blocks,
    field[G_R][C/L][L] g_baseB_decomps,
    // constant tables depending on param values
    // // wb tables
    field[TABLE_LEN][6] wb_chunk_lookup_table,
    field[WB_M][2] wb_powers_of_b,
    field[WB_B] wb_range_check_table,
    // // garbage tables
    field[TABLE_LEN][6] g_chunk_lookup_table,
    field[G_M][2] g_powers_of_b,
    field[G_B] g_range_check_table    
) -> bool {
    bool wb_blocks_ok = check_blocks::<R,C,L,TABLE_LEN,WB_B,WB_NB,WB_M,WB_LOGM>(
        well_behaved,
        wb_lookups,
        wb_chunk_lookup_table,
        wb_powers_of_b,
        wb_blocks,
        wb_baseB_decomps,
        wb_range_check_table
    );

    bool g_blocks_ok = check_blocks::<G_R,C,L,TABLE_LEN,G_B,G_NB,G_M,G_LOGM>(
        garbage,
        g_lookups,
        g_chunk_lookup_table,
        g_powers_of_b,
        g_blocks,
        g_baseB_decomps,
        g_range_check_table
    );

    bool split_ok = check_garbage_split::<R,C,G_R>(
        bin_image,
        well_behaved,
        wb_inds,
        wb_ind_counts,
        garbage,
        garbage_inds,
        num_zero_rows
    );

    return(wb_blocks_ok && g_blocks_ok && split_ok);
}

// test function

// Range check tables
const field[WB_B] WB_RANGE_CHECK_TABLE = RANGE_0_105;
const field[G_B] G_RANGE_CHECK_TABLE = RANGE_0_1081;

// NOTE: it is important that all three of these constants match test image / witness gen or the proof will not verify!
const u32 R = 32;
const u32 C = 360;
const u32 G_R = 31;

def main(
    // The full binary image and the split into well-behaved / garbage rows
    private field[R][C] bin_image,
    private field[R][C] well_behaved,
    private field[R] wb_inds,
    private field[R] wb_ind_counts,
    private field[G_R][C] garbage_image,
    private field[G_R] garbage_inds,
    private field num_zero_rows,
    // Well-behaved block checking metadata
    private BlockLookup[R][C/L] wb_lookups,
    private field[R][WB_NB] wb_blocks,
    private field[R][C/L][L] wb_baseB_decomps,
    // Garbage block checking metadata
    private BlockLookup[G_R][C/L] g_lookups,
    private field[G_R][G_NB] g_blocks,
    private field[G_R][C/L][L] g_baseB_decomps
) {
    assert(block_measurement::<R,C,L,TABLE_LEN,G_R, WB_B, WB_NB, WB_M, WB_LOGM, G_B, G_NB, G_M, G_LOGM>(
        bin_image,
        well_behaved,
        wb_inds,
        wb_ind_counts,
        garbage_image,
        garbage_inds,
        num_zero_rows,
        wb_lookups,
        wb_blocks,
        wb_baseB_decomps,
        g_lookups,
        g_blocks,
        g_baseB_decomps,
        WB_CHUNK_LOOKUP_TABLE,
        WB_POWERS_OF_B,
        WB_RANGE_CHECK_TABLE,
        G_CHUNK_LOOKUP_TABLE,
        G_POWERS_OF_B,
        G_RANGE_CHECK_TABLE
    ));
}
