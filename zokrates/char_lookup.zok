// Lookup tables and helper functions for character interpretation state machine.

from "EMBED" import value_in_array;
from "./const_range_check.zok" import RANGE_0_128, RANGE_0_4, RANGE_0_30;

// PDF417 Text Compaction Mode - Flattened Interpretation Table
// Contains 4 sub-modes x 30 values each = 120 total entries
// Order: Alpha (0-29), Lower (30-59), Mixed (60-89), Punctuation (90-119), ZERO, SLD, PAD, EC
// Encoded as (next_next_table*2^16 + next_table*2^14 + this_table*2^12 + char*2^5 + base30_val)
// see char_array.py for generation code
const field[124] ENCODED_STATE_MACHINE = [2080, 2113, 2146, 2179, 2212, 2245, 2278, 2311, 2344, 2377, 2410, 2443, 2476, 2509, 2542, 2575, 2608, 2641, 2674, 2707, 2740, 2773, 2806, 2839, 2872, 2905, 1050, 81947, 163868, 49181, 89120, 89153, 89186, 89219, 89252, 89285, 89318, 89351, 89384, 89417, 89450, 89483, 89516, 89549, 89582, 89615, 89648, 89681, 89714, 89747, 89780, 89813, 89846, 89879, 89912, 89945, 87066, 69659, 167964, 118813, 173568, 173601, 173634, 173667, 173700, 173733, 173766, 173799, 173832, 173865, 173258, 172459, 172332, 173453, 173902, 173167, 173488, 173521, 173202, 173555, 173428, 173237, 173398, 174007, 175064, 253977, 173082, 90139, 8220, 188445, 259936, 259969, 260034, 260099, 260964, 260997, 261030, 261095, 261128, 262089, 259114, 258475, 258348, 259469, 259918, 258383, 259504, 259537, 259218, 259571, 259156, 262037, 259414, 259351, 259384, 260089, 262010, 262075, 259324, 12317, 0, 3040, 1024, 192];

struct TableState {
    field base30_val;
    field char;

    field this_table;
    field next_table;
    field next_next_table;
}

def encode_table_state(TableState table_state) -> field {
    return(table_state.next_next_table * 2**16 + table_state.next_table * 2**14 + table_state.this_table * 2**12 + table_state.char * 2**5 + table_state.base30_val);
}

// the bool returned here doesn't actually check anything. The asserts inside the function are doing all the work.
def check_table_state(TableState table_state) -> bool {
    field encoded_state = encode_table_state(table_state);
    assert(value_in_array(encoded_state, ENCODED_STATE_MACHINE));

    assert(value_in_array(table_state.base30_val, RANGE_0_30));
    assert(value_in_array(table_state.char, RANGE_0_128));
    assert(value_in_array(table_state.this_table, RANGE_0_4));
    assert(value_in_array(table_state.next_table, RANGE_0_4));
    assert(value_in_array(table_state.next_next_table, RANGE_0_4));

    return true;
}

