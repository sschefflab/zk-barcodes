def encode_state_tuple(TableState state1, TableState state2) -> field {
    field encoded1 = encode_table_state(state1);
    field encoded2 = encode_table_state(state2);
    // We don't need to check any ranges here because we already know these are encoded states
    return(encoded1 * 2**18 + encoded2);
}

def check_transition(TableState state1, TableState state2) -> bool {
    field encoded_tuple = encode_state_tuple(state1, state2);
    assert(value_in_array(encoded_tuple, VALID_TRANSITIONS));
    return(true);
}

// test main function
def main(private TableState state1, private TableState state2, private TableState state3) {
    // assert(check_table_state(state1));
    // assert(check_table_state(state2));
    assert(check_transition(state1, state2));
    assert(check_transition(state2, state3));
}
