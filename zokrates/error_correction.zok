// Check error correction
// Check that the barcode's stats (num_rows, num_cols, and error correction level) are extracted from row indicators correctly.
// Check that error correction is done correctly.

from "EMBED" import value_in_array, value_in_array_tuple, u32_to_field, unpack;
from "./utils.zok" import diff_lookup, check_bit_decomp;
from "./const_range_check.zok" import RANGE_0_3, RANGE_0_30, RANGE_1_513, RANGE_EC_LEVEL, RANGE_NUM_ROWS, RANGE_NUM_COLS, POWERS_OF_TWO, GF_929, POWERS_OF_3_MOD_929;

struct BarcodeStats {
     field num_rows;
     field num_cols;

     field ec_level;
     field num_ec_codewords;
}

// needs to be data from the first three left row indicators
struct RowIndicatorVars {
    field l0;
    field l3;
    field l6;

    field q0;
    field q3;
    field q6;

    field r0;
    field r3;
}

def check_division_algorithm_inner<Q>(field y, field x, field q, field r, field[Q] range_check_table) -> bool {
    bool div_alg = (y == q * x + r);
    field Q_field = u32_to_field(Q);
    assert(Q_field == q);
    assert(value_in_array(r, range_check_table));
    return(div_alg);
}


// These functions add bounds on q. This is not needed over the integers,
// but needed here to make sure the prover can't cheat by overflowing the field modulus.
def check_division_algorithm_quotient_range_check<Q,N>(field y, field x, field q, field r, field[Q] range_check_table, field[N] quotient_check_table) -> bool {
    assert(value_in_array(x, quotient_check_table));
    return(check_division_algorithm_inner(y, x, q, r, range_check_table));
}

def check_division_algorithm_quotient_bit_decomp<Q,B>(field y, field x, field q, field r, field[Q] range_check_table) -> bool {
    bool[B] x_bits = unpack(x);
    assert(check_bit_decomp(x, x_bits));
    return(check_division_algorithm_inner(y, x, q, r, range_check_table));
}

def check_barcode_stats<R>(
    RowIndicatorVars row_indc,
    BarcodeStats stats,
    field[R] left_row_inds
) -> bool {
    // table lookups end up being way cheaper in constraints than ZoKrates comparisons

    // The value of the whole indicator must be in GF929, so the quotient is definitely in GF929.
    // The point of that check is not overflowing the field modulus, so GF929 is a tight enough check.
    // We are already using the GF929 table elsewhere, so it is more efficient to reuse that instead of constructing a new table,
    // even if that gives us a tighter bound.
    bool div_alg0 = check_division_algorithm_quotient_range_check(row_indc.l0, row_indc.q0, 30, row_indc.r0, RANGE_0_30, GF_929);
    bool div_alg3 = check_division_algorithm_quotient_range_check(row_indc.l3, row_indc.q3, 30, row_indc.r3, RANGE_0_30, GF_929);
    bool div_alg6 = check_division_algorithm_quotient_range_check(row_indc.l6, row_indc.q6, 30, stats.num_cols - 1, RANGE_0_30, GF_929);
 
    field dr = row_indc.r3 - 3 * stats.ec_level;
    bool div_alg_r = check_division_algorithm_quotient_range_check(stats.num_rows - 1, row_indc.r0, 3, dr, RANGE_0_3, GF_929);

    assert(value_in_array(stats.ec_level, RANGE_EC_LEVEL));
    assert(value_in_array(stats.num_rows, RANGE_NUM_ROWS));
    // don't need to separately check RANGE_NUM_COLS - it is checked in div_alg6 above


    // these equality checks are not actually generating constraints - CirC is able to optimize them away with substitution
    assert(row_indc.l0 == left_row_inds[0]);
    assert(row_indc.l3 == left_row_inds[1]);
    assert(row_indc.l6 == left_row_inds[2]);

    assert(value_in_array_tuple([stats.ec_level+1, stats.num_ec_codewords], POWERS_OF_TWO));

    return(div_alg0 && div_alg3 && div_alg6 && div_alg_r);
}

// data for checking evaluation of a polynomial modulo 929
struct PolynomialResult {
    field result; // the sum of all the terms mod 929
    field result_quotient; // the integer division value when computing mod 929 for the sum

    bool should_be_zero;
}

// Expects codewords and corrected_codewords to be left-padded with zeros to fit length W
def check_error_correction<W,MAX_EC>(field[W] codewords, field[W] corrected_codewords, field num_ec_codewords, PolynomialResult[MAX_EC] poly_witness) -> bool {
    // sparsity check: 2w + 10
    field mut t = 0;
    for u32 k in 0..W {
        field error = codewords[k] - corrected_codewords[k];
        field to_add = (error == 0) ? 0 : 1;
        t = t + to_add;
    }

    field sparsity = num_ec_codewords - 2*t - 4;
    bool[9] bits = unpack(sparsity);
    bool sufficiently_sparse = check_bit_decomp(sparsity, bits);

    bool mut zero_syndromes = true;
    // possible error correction levels are [0,8]. Need i's in range [1, 2**(ec_level+1)]. Note the closed interval, hence the range to 513 instead of 512
    for u32 i in 1..MAX_EC+1 {
        // Polynomial evaluation at eval point 3^i mod 929
        // powers[j] = (3^i)^(W-1-j) mod 929 = POWERS_OF_3_MOD_929[(i*(W-1-j)) % 928]
        // Since i and j are compile-time constants, (i*(W-1-j)) % 928 is computed at compile time
        field mut sum_pre_mod = 0;
        for u32 j in 0..W {
            sum_pre_mod = sum_pre_mod + corrected_codewords[j] * POWERS_OF_3_MOD_929[(i * (W - 1 - j)) % 928];
        }

        // Since we are iterating starting at 1, subtract 1 from i
        PolynomialResult poly_result = poly_witness[i-1];

        // 22 bits is sufficient here as the upper bound on the quotient should be 929*2700. (Upper bound on sum_pre_mod is 929*929*2700.)
        bool correct_eval = check_division_algorithm_quotient_bit_decomp::<929,22>(sum_pre_mod, poly_result.result_quotient, 929, poly_result.result, GF_929);
        bool zero_syndrome = correct_eval && (poly_result.result == 0);

        field i_f = u32_to_field(i);

        // check that prover-provided should_be_zero is correct. We only care that it is false when it should be. Extra true's do not affect soundness.
        field to_compare = if (poly_result.should_be_zero) {
            0
        } else {
            num_ec_codewords
        };
        bool always_true = diff_lookup(i_f, to_compare, RANGE_1_513); // this function always returns true but does an assert inside
        
        zero_syndromes = zero_syndromes && (!poly_result.should_be_zero || zero_syndrome);
        
    }

    return(sufficiently_sparse && zero_syndromes);
}

// test function
const u32 R = 90;
const u32 W = 2700;
const u32 MAX_EC = 512;

def main(
    // private RowIndicatorVars row_indc,
    // private field[R] left_row_inds,
    private BarcodeStats stats,
    private PolynomialResult[MAX_EC] poly_witness,
    private field[W] codewords,
    private field[W] corrected_codewords
) -> () {
    // bool ok_stats = check_barcode_stats(row_indc, stats, left_row_inds);
    // assert(ok_stats);
    bool ok_ec = check_error_correction(codewords, corrected_codewords, stats.num_ec_codewords, poly_witness);
    assert(ok_ec);
}
