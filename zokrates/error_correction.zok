from "EMBED" import value_in_array, u32_to_field;
from "./const_range_check.zok" import RANGE_0_3, RANGE_0_30, RANGE_EC_LEVEL, RANGE_NUM_ROWS, RANGE_NUM_COLS;

struct BarcodeStats {
     field ec_level;
     field num_rows;
     field num_cols;
}

def check_division_algorithm<Q>(field y, field x, field q, field r, field[Q] range_check_table) -> bool {
    bool div_alg = (y == q * x + r);
    field Q_field = u32_to_field(Q);
    assert(Q_field == q);
    assert(value_in_array(r, range_check_table));
    return(div_alg);
}

def check_barcode_stats(
    field l0,
    field l3,
    field l6,
    BarcodeStats stats,
    // Witness variables for quotients and remainders
    field q0,
    field r0,
    field q3,
    field r3,
    field q6 
) -> () {
    // table lookups end up being way cheaper in constraints than ZoKrates comparisons

    assert(check_division_algorithm(l0, q0, 30, r0, RANGE_0_30));
    assert(check_division_algorithm(l3, q3, 30, r3, RANGE_0_30));
    assert(check_division_algorithm(l6, q6, 30, stats.num_cols - 1, RANGE_0_30));
 
    field dr = r3 - 3 * stats.ec_level;
    assert(check_division_algorithm(stats.num_rows - 1, r0, 3, dr, RANGE_0_3));

    assert(value_in_array(stats.ec_level, RANGE_EC_LEVEL));
    assert(value_in_array(stats.num_rows, RANGE_NUM_ROWS));
    assert(value_in_array(stats.num_cols, RANGE_NUM_COLS));
}

// TODO: write some function to check error correction

def check_barcode_size<W>(field[W] corrected_codewords, field num_rows, field num_cols) -> bool {
    field mut num_nonzero = 0;

    for u32 i in 0..W {
        field to_add = (corrected_codewords[i] == 0) ? 1 : 0;
        num_nonzero = num_nonzero + to_add;
    }

    return(num_nonzero <= num_rows * num_cols);
}

// test function
def main(
    field l0,
    field l3,
    field l6,
    private BarcodeStats stats,
    field q0,
    field qr,
    field q3,
    field r3,
    field q6 
) -> () {
    return(check_barcode_stats(l0, l3, l6, stats, q0, qr, q3, r3, q6));
}
