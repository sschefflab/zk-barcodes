from "EMBED" import value_in_array, u32_to_field, unpack;
from "./utils.zok" import gt_9bit;
from "./const_range_check.zok" import RANGE_0_3, RANGE_0_30, RANGE_EC_LEVEL, RANGE_NUM_ROWS, RANGE_NUM_COLS, POWERS_OF_TWO, GF_929, POWERS_OF_3_MOD_929;

struct BarcodeStats {
     field ec_level;
     field num_rows;
     field num_cols;
}

struct RowIndicatorVars {
    field l0;
    field l3;
    field l6;

    field q0;
    field q3;
    field q6;

    field r0;
    field r3;
}

// MSB to LSB
def check_bit_decomp<B>(field v, bool[B] bits) -> bool {
    field mut sum = 0;
    
    for u32 i in 0..B {
        field field_bit = bits[i] ? 1 : 0;
        sum = sum + 2**(B - i - 1)*field_bit;
    }

    return(sum == v);
}

def check_division_algorithm_inner<Q>(field y, field x, field q, field r, field[Q] range_check_table) -> bool {
    bool div_alg = (y == q * x + r);
    field Q_field = u32_to_field(Q);
    assert(Q_field == q);
    assert(value_in_array(r, range_check_table));
    return(div_alg);
}


// These functions add bounds on q. This is not needed over the integers,
// but needed here to make sure the prover can't cheat by overflowing the field modulus.
def check_division_algorithm_quotient_range_check<Q,N>(field y, field x, field q, field r, field[Q] range_check_table, field[N] quotient_check_table) -> bool {
    assert(value_in_array(x, quotient_check_table));
    return(check_division_algorithm_inner(y, x, q, r, range_check_table));
}

def check_division_algorithm_quotient_bit_decomp<Q,B>(field y, field x, field q, field r, field[Q] range_check_table) -> bool {
    bool[B] x_bits = unpack(x);
    assert(check_bit_decomp(x, x_bits));
    return(check_division_algorithm_inner(y, x, q, r, range_check_table));
}


// 170 constraints - comes from table setup
// TODO - we can maybe make this smaller by getting rid of the lookup tables
def check_barcode_stats(
    RowIndicatorVars row_indc,
    BarcodeStats stats
) -> bool {
    // table lookups end up being way cheaper in constraints than ZoKrates comparisons

    // The value of the whole indicator must be in GF929, so the quotient is definitely in GF929.
    // The point of that check is not overflowing the field modulus, so GF929 is a tight enough check.
    // We are already using the GF929 table elsewhere, so it is more efficient to reuse that instead of constructing a new table,
    // even if that gives us a tighter bound.
    bool div_alg0 = check_division_algorithm_quotient_range_check(row_indc.l0, row_indc.q0, 30, row_indc.r0, RANGE_0_30, GF_929);
    bool div_alg3 = check_division_algorithm_quotient_range_check(row_indc.l3, row_indc.q3, 30, row_indc.r3, RANGE_0_30, GF_929);
    bool div_alg6 = check_division_algorithm_quotient_range_check(row_indc.l6, row_indc.q6, 30, stats.num_cols - 1, RANGE_0_30, GF_929);
 
    field dr = row_indc.r3 - 3 * stats.ec_level;
    bool div_alg_r = check_division_algorithm_quotient_range_check(stats.num_rows - 1, row_indc.r0, 3, dr, RANGE_0_3, GF_929);

    assert(value_in_array(stats.ec_level, RANGE_EC_LEVEL));
    assert(value_in_array(stats.num_rows, RANGE_NUM_ROWS));
    assert(value_in_array(stats.num_cols, RANGE_NUM_COLS));
    return(div_alg0 && div_alg3 && div_alg6 && div_alg_r);
}

// data for checking evaluation of a polynomial modulo 929
struct PolynomialResult {
    field result; // the sum of all the terms mod 929
    field result_quotient; // the integer division value when computing mod 929 for the sum
}

def check_error_correction<W>(field[W] codewords, field[W] corrected_codewords, field ec_level, PolynomialResult[512] poly_witness) -> bool {
    field mut t = 0;
    for u32 k in 0..W {
        field error = codewords[k] - corrected_codewords[k];
        field to_add = (error == 0) ? 0 : 1;
        t = t + to_add;
    }

    field power_of_two = POWERS_OF_TWO[ec_level+1];

    field sparsity = power_of_two - 2*t - 4;
    bool[9] bits = unpack(sparsity);
    bool sufficiently_sparse = check_bit_decomp(sparsity, bits);

    bool mut zero_syndromes = true;
    // possible error correction levels are [0,8]. Need i's in range [0, 2**(ec_level+1)]
    for u32 i in 0..512 {
        // Polynomial evaluation at eval point 3^i mod 929
        // powers[j] = (3^i)^j mod 929 = 3^(i*j) mod 929 = POWERS_OF_3_MOD_929[(i*j) % 928]
        // Since i and j are compile-time constants, (i*j) % 928 is computed at compile time
        field mut sum_pre_mod = 0;
        for u32 j in 0..W {
            sum_pre_mod = sum_pre_mod + corrected_codewords[j] * POWERS_OF_3_MOD_929[(i * j) % 928];
        }

        // 22 bits is sufficient here as the upper bound on the quotient should be 929*3071. (Upper bound on sum_pre_mod is 929*929*3071.)
        // TODO: this could maybe be faster using lookup tables instead of bit decomp, but as-is the lookup table is too big
        bool correct_eval = check_division_algorithm_quotient_bit_decomp::<929,22>(sum_pre_mod, poly_witness[i].result_quotient, 929, poly_witness[i].result, GF_929);
        bool zero_syndrome = correct_eval && (poly_witness[i].result == 0);
        zero_syndromes = zero_syndromes && zero_syndrome;

        field i_f = u32_to_field(i);
        zero_syndromes = zero_syndromes && (gt_9bit(i_f, power_of_two) || zero_syndrome);
        
    }

    return(sufficiently_sparse && zero_syndromes);
}

// some small setup and then approximately 2W constraints
def check_barcode_size<W>(field[W] corrected_codewords, field num_rows, field num_cols) -> bool {
    field mut num_nonzero = 0;

    for u32 i in 0..W {
        field to_add = (corrected_codewords[i] == 0) ? 1 : 0;
        num_nonzero = num_nonzero + to_add;
    }

    field v = num_rows * num_cols - num_nonzero;
    // 12 bits is sufficient here because num_rows * num_cols <= 90*30 < 4096
    bool[12] bits = unpack(v);

    return(check_bit_decomp(v, bits));
}

// test function
const u32 W = 2;

def main(
    private RowIndicatorVars row_indc,
    private BarcodeStats stats,
    private PolynomialResult[512] poly_witness,
    field[W] codewords,
    field[W] corrected_codewords
) -> () {
    // bool ok_stats = check_barcode_stats(row_indc, stats); // constant 1102 constraints - does not depend on W
    // assert(ok_stats);
    bool ok_ec = check_error_correction(codewords, corrected_codewords, stats.ec_level, poly_witness);
    assert(ok_ec);
    // bool ok_barcode_size = check_barcode_size(corrected_codewords, stats.num_rows, stats.num_cols);
    // assert(ok_barcode_size);
}
