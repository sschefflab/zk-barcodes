from "../make_words.zok" import compute_words;
from "../make_codewords.zok" import check_codewords_and_garbage, T;
from "../block_measurement_const.zok" import WB_WW, WB_NB, WB_CW, G_WW, G_NB, G_CW;
from "../const_range_check.zok" import RANGE_0_432, RANGE_0_2160;

// NOTE: it is important that all four of these parameters match what was used to generate the witness in order for the proof to go through!
const u32 R = 720;
const u32 G_R = 89;
const u32 RW = 90;         // max number of logical barcode rows
const u32 W = 2700;

def main(
    private field[R][WB_NB] wb_blocks,
    private field[G_R][G_NB] g_blocks,
    private field[R][WB_CW][6] wb_normalized_widths,
    private field[G_R][G_CW][6] g_normalized_widths,
    private field[R][WB_CW] words_with_dummies,
    field[T] wb_disjoint_set_poly_f,
    private field[R*WB_CW] wb_disjoint_set_poly_g,
    private field[R][WB_CW] ext_codewords,
    private field[W] codewords,
    private field[RW] left_row_inds,
    private field[G_R] garbage_words,
    private field[G_R] garbage_word_index,
    field[T] garbage_disjoint_set_poly_f,
    private field[G_R] garbage_disjoint_set_poly_g
) {
    field[R][WB_CW] words = compute_words::<R, WB_WW, WB_NB, WB_CW>(wb_blocks, wb_normalized_widths, RANGE_0_432);
    field[G_R][G_CW] garbage_rows = compute_words::<G_R, G_WW, G_NB, G_CW>(g_blocks, g_normalized_widths, RANGE_0_2160);

    assert(check_codewords_and_garbage::<R, RW, WB_CW, G_R, G_CW, W>(
        words,
        words_with_dummies,
        wb_disjoint_set_poly_f,
        wb_disjoint_set_poly_g,
        ext_codewords,
        codewords,
        left_row_inds,
        garbage_rows,
        garbage_words,
        garbage_word_index,
        garbage_disjoint_set_poly_f,
        garbage_disjoint_set_poly_g
    ));
}
