from "../block_measurement_const.zok" import L_SMALL, TABLE_LEN_SMALL, WB_B_SMALL, WB_NB_SMALL, WB_M_SMALL, WB_LOGM_SMALL, WB_POWERS_OF_B_SMALL, WB_CHUNK_LOOKUP_TABLE_SMALL, G_B_SMALL, G_NB_SMALL, G_M_SMALL, G_LOGM_SMALL, G_POWERS_OF_B_SMALL, G_CHUNK_LOOKUP_TABLE_SMALL;
from "../const_range_check.zok" import RANGE_0_25, RANGE_0_193;
from "../block_measurement.zok" import block_measurement, BlockLookup;


const field[WB_B_SMALL] WB_RANGE_CHECK_TABLE = RANGE_0_25;
const field[G_B_SMALL] G_RANGE_CHECK_TABLE = RANGE_0_193;

const u32 R = 144;
const u32 C = 192;
const u32 G_R = 89;


def main(
    // The full binary image and the split into well-behaved / garbage rows
    private field[R][C] bin_image,
    private field[R][C] well_behaved,
    private field[R] wb_inds,
    private field[R] ind_counts,
    private field[G_R][C] garbage_image,
    private field[G_R] garbage_inds,
    private field num_zero_rows,
    // Well-behaved block checking metadata
    private BlockLookup[R][C/L_SMALL] wb_lookups,
    private field[R][WB_NB_SMALL] wb_blocks,
    private field[R][C/L_SMALL][L_SMALL] wb_baseB_decomps,
    // Garbage block checking metadata
    private BlockLookup[G_R][C/L_SMALL] g_lookups,
    private field[G_R][G_NB_SMALL] g_blocks,
    private field[G_R][C/L_SMALL][L_SMALL] g_baseB_decomps
) {
    assert(block_measurement::<R,C,L_SMALL,TABLE_LEN_SMALL,G_R, WB_B_SMALL, WB_NB_SMALL, WB_M_SMALL, WB_LOGM_SMALL, G_B_SMALL, G_NB_SMALL, G_M_SMALL, G_LOGM_SMALL>(
        bin_image,
        well_behaved,
        wb_inds,
        ind_counts,
        garbage_image,
        garbage_inds,
        num_zero_rows,
        wb_lookups,
        wb_blocks,
        wb_baseB_decomps,
        g_lookups,
        g_blocks,
        g_baseB_decomps,
        WB_CHUNK_LOOKUP_TABLE_SMALL,
        WB_POWERS_OF_B_SMALL,
        WB_RANGE_CHECK_TABLE,
        G_CHUNK_LOOKUP_TABLE_SMALL,
        G_POWERS_OF_B_SMALL,
        G_RANGE_CHECK_TABLE
    ));
}
