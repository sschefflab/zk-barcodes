// Generic full-circuit entry point for benchmarking.
// All parametric constants are imported from params.zok (auto-generated by rxing into test-witness/).

from "../../test-witness/params.zok" import L, TABLE_LEN,
    WB_B, WB_NB, WB_M, WB_LOGM, WB_CW, WB_WW,
    WB_POWERS_OF_B, WB_CHUNK_LOOKUP_TABLE,
    G_B, G_NB, G_M, G_LOGM, G_CW, G_WW,
    G_POWERS_OF_B, G_CHUNK_LOOKUP_TABLE,
    RANGE_0_WB_B, RANGE_0_G_B,
    WB_WORDS_RANGE, G_WORDS_RANGE,
    IR, IC, R, C, R_START, C_START,
    R_W as RW, EC, G_R, W, EC_W as EC_CW, QBITS,
    RANGE_EC_LEVEL, RANGE_NUM_ROWS, EC_CW_RANGE, POWERS_OF_TWO;
from "../block_measurement.zok" import BlockLookup, block_measurement;
from "../make_codewords.zok" import T;
from "../error_correction.zok" import BarcodeRanges, BarcodeStats, RowIndicatorVars, PolynomialResult;
from "../char_lookup.zok" import TableState;
from "../full_circuit.zok" import full_circuit;

const field[WB_B] WB_RANGE_CHECK_TABLE = RANGE_0_WB_B;
const field[G_B] G_RANGE_CHECK_TABLE = RANGE_0_G_B;
const field[2*WB_WW] WB_WORDS_RANGE_TABLE = WB_WORDS_RANGE;
const field[2*G_WW] G_WORDS_RANGE_TABLE = G_WORDS_RANGE;

def main(
    private field[IR][IC] image,
    private field[R][C] bin_image,
    // block_measurement inputs
    private field[R][C] well_behaved,
    private field[R] wb_inds,
    private field[R] ind_counts,
    private field[G_R][C] garbage_image,
    private field[G_R] garbage_inds,
    private field num_zero_rows,
    private BlockLookup[R][C/L] wb_lookups,
    private field[R][WB_NB] wb_blocks,
    private field[R][C/L][L] wb_baseB_decomps,
    private BlockLookup[G_R][C/L] g_lookups,
    private field[G_R][G_NB] g_blocks,
    private field[G_R][C/L][L] g_baseB_decomps,
    // make_words inputs
    private field[R][WB_CW][8] wb_normalized_blocks,
    private field[G_R][G_CW][8] g_normalized_blocks,
    // check_codewords_and_garbage inputs
    private field[R][WB_CW] words_with_dummies,
    field[T] wb_disjoint_set_poly_f,
    private field[R*WB_CW] wb_disjoint_set_poly_g,
    private field[R][WB_CW] ext_codewords,
    private field[W] codewords,
    private field[RW] left_row_inds,
    private field[G_R] garbage_words,
    private field[G_R] garbage_word_index,
    field[T] garbage_disjoint_set_poly_f,
    private field[G_R] garbage_disjoint_set_poly_g,
    // error correction and decoding
    private RowIndicatorVars row_indc,
    private field[W] corrected_codewords,
    private PolynomialResult[EC_CW] poly_witness,
    private BarcodeStats stats,
    private TableState[2*W] char_table_states,
    private field[2*W] chars
) {
    BarcodeRanges<RW,EC,EC_CW> ranges = BarcodeRanges { ec_level_range : RANGE_EC_LEVEL, num_rows_range : RANGE_NUM_ROWS, ec_cw_range : EC_CW_RANGE, powers_of_two : POWERS_OF_TWO };

    assert(full_circuit::<IR, IC, R, C, R_START, C_START, L, TABLE_LEN, G_R, G_B, G_WW, G_NB, G_M, G_LOGM, WB_B, WB_WW, WB_NB, WB_M, WB_LOGM, WB_CW, G_CW, RW, W, EC, EC_CW, QBITS>(
        image,
        bin_image,
        // block_measurement inputs
        well_behaved,
        wb_inds,
        ind_counts,
        garbage_image,
        garbage_inds,
        num_zero_rows,
        wb_lookups,
        wb_blocks,
        wb_baseB_decomps,
        g_lookups,
        g_blocks,
        g_baseB_decomps,
        WB_CHUNK_LOOKUP_TABLE,
        WB_POWERS_OF_B,
        WB_RANGE_CHECK_TABLE,
        G_CHUNK_LOOKUP_TABLE,
        G_POWERS_OF_B,
        G_RANGE_CHECK_TABLE,
        WB_WORDS_RANGE_TABLE,
        G_WORDS_RANGE_TABLE,
        // make_words inputs
        wb_normalized_blocks,
        g_normalized_blocks,
        // check_codewords_and_garbage inputs
        words_with_dummies,
        wb_disjoint_set_poly_f,
        wb_disjoint_set_poly_g,
        ext_codewords,
        codewords,
        left_row_inds,
        garbage_words,
        garbage_word_index,
        garbage_disjoint_set_poly_f,
        garbage_disjoint_set_poly_g,
        // error correction and decoding
        ranges,
        row_indc,
        corrected_codewords,
        poly_witness,
        stats,
        char_table_states,
        chars
    ));
}
