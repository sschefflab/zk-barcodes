from "../../test-witness/params.zok" import R_W as RW, QBITS, EC, EC_W as EC_CW, W, RANGE_EC_LEVEL, RANGE_NUM_ROWS, EC_CW_RANGE, POWERS_OF_TWO;
from "../error_correction.zok" import BarcodeRanges, BarcodeStats, PolynomialResult, check_error_correction;

def main(
    private BarcodeStats stats,
    private PolynomialResult[EC_CW] poly_witness,
    private field[W] codewords,
    private field[W] corrected_codewords
) {
    BarcodeRanges<RW, EC, EC_CW> ranges = BarcodeRanges { ec_level_range : RANGE_EC_LEVEL, num_rows_range : RANGE_NUM_ROWS, ec_cw_range : EC_CW_RANGE, powers_of_two : POWERS_OF_TWO };
    assert(check_error_correction::<RW, W, QBITS, EC, EC_CW>(codewords, corrected_codewords, stats.num_ec_codewords, poly_witness, ranges));
}
