from "../block_measurement_const.zok" import L, TABLE_LEN, WB_B_SD, WB_NB_SD, WB_M_SD, WB_LOGM_SD, WB_POWERS_OF_B_SD, WB_CHUNK_LOOKUP_TABLE_SD, G_B_SD, G_NB_SD, G_M_SD, G_LOGM_SD, G_POWERS_OF_B_SD, G_CHUNK_LOOKUP_TABLE_SD;
from "../const_range_check.zok" import RANGE_0_65, RANGE_0_641;
from "../block_measurement.zok" import block_measurement, BlockLookup;


const field[WB_B_SD] WB_RANGE_CHECK_TABLE = RANGE_0_65;
const field[G_B_SD] G_RANGE_CHECK_TABLE = RANGE_0_641;

const u32 R = 480;
const u32 C = 640;
const u32 G_R = 89;


def main(
    // The full binary image and the split into well-behaved / garbage rows
    private field[R][C] bin_image,
    private field[R][C] well_behaved,
    private field[R] wb_inds,
    private field[R] wb_ind_counts,
    private field[G_R][C] garbage_image,
    private field[G_R] garbage_inds,
    private field num_zero_rows,
    // Well-behaved block checking metadata
    private BlockLookup[R][C/L] wb_lookups,
    private field[R][WB_NB_SD] wb_blocks,
    private field[R][C/L][L] wb_baseB_decomps,
    // Garbage block checking metadata
    private BlockLookup[G_R][C/L] g_lookups,
    private field[G_R][G_NB_SD] g_blocks,
    private field[G_R][C/L][L] g_baseB_decomps
) {
    assert(block_measurement::<R,C,L,TABLE_LEN,G_R, WB_B_SD, WB_NB_SD, WB_M_SD, WB_LOGM_SD, G_B_SD, G_NB_SD, G_M_SD, G_LOGM_SD>(
        bin_image,
        well_behaved,
        wb_inds,
        wb_ind_counts,
        garbage_image,
        garbage_inds,
        num_zero_rows,
        wb_lookups,
        wb_blocks,
        wb_baseB_decomps,
        g_lookups,
        g_blocks,
        g_baseB_decomps,
        WB_CHUNK_LOOKUP_TABLE_SD,
        WB_POWERS_OF_B_SD,
        WB_RANGE_CHECK_TABLE,
        G_CHUNK_LOOKUP_TABLE_SD,
        G_POWERS_OF_B_SD,
        G_RANGE_CHECK_TABLE
    ));
}
