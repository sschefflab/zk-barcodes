// Entire PDF417 decoding verifier circuit

from "../block_measurement_const.zok" import L_SMALL, TABLE_LEN_SMALL, WB_B_SMALL, WB_NB_SMALL, WB_M_SMALL, WB_LOGM_SMALL, WB_CW_SMALL, WB_POWERS_OF_B_SMALL, WB_CHUNK_LOOKUP_TABLE_SMALL, WB_WW_SMALL, G_B_SMALL, G_NB_SMALL, G_M_SMALL, G_LOGM_SMALL, G_CW_SMALL, G_POWERS_OF_B_SMALL, G_CHUNK_LOOKUP_TABLE_SMALL, G_WW_SMALL;
from "../block_measurement.zok" import BlockLookup, block_measurement;
from "../const_range_check.zok" import RANGE_0_25, RANGE_0_193, RANGE_0_78, RANGE_0_384, RANGE_1_513, RANGE_EC_LEVEL, RANGE_NUM_ROWS, POWERS_OF_TWO;
from "../make_codewords.zok" import T;
from "../error_correction.zok" import BarcodeRanges, BarcodeStats, RowIndicatorVars, PolynomialResult;
from "../char_lookup.zok" import TableState;
from "../full_circuit.zok" import full_circuit;

const u32 IR = 144;         // full image rows
const u32 IC = 192;         // full image cols
const u32 R = 20;           // barcode crop rows
const u32 C = 188;          // barcode crop cols
const u32 R_START = 62;
const u32 C_START = 2;
const u32 G_R = 89;         // number of garbage rows (should be 89)
const u32 N = IR * IC;      // total number of pixels

const field[WB_B_SMALL] WB_RANGE_CHECK_TABLE = RANGE_0_25;
const field[G_B_SMALL] G_RANGE_CHECK_TABLE = RANGE_0_193;
const field[2*WB_WW_SMALL] WB_WORDS_RANGE_TABLE = RANGE_0_78;
const field[2*G_WW_SMALL] G_WORDS_RANGE_TABLE = RANGE_0_384;

const u32 W = R * WB_CW_SMALL;  // total number of codewords
const u32 RW = 90;         // max number of logical barcode rows possible (should be 90)
const u32 EC = 8;
const u32 EC_CW = 512;
const u32 QBITS = 22;

def main(
    private field[IR][IC] image,
    private field[R][C] bin_image,
    // block_measurement inputs
    private field[R][C] well_behaved,
    private field[R] wb_inds,
    private field[R] ind_counts,
    private field[G_R][C] garbage_image,
    private field[G_R] garbage_inds,
    private field num_zero_rows,
    private BlockLookup[R][C/L_SMALL] wb_lookups,
    private field[R][WB_NB_SMALL] wb_blocks,
    private field[R][C/L_SMALL][L_SMALL] wb_baseB_decomps,
    private BlockLookup[G_R][C/L_SMALL] g_lookups,
    private field[G_R][G_NB_SMALL] g_blocks,
    private field[G_R][C/L_SMALL][L_SMALL] g_baseB_decomps,
    // make_words inputs
    private field[R][WB_CW_SMALL][6] wb_normalized_widths,
    private field[G_R][G_CW_SMALL][6] g_normalized_widths,
    // check_codewords_and_garbage inputs
    private field[R][WB_CW_SMALL] words_with_dummies,
    field[T] wb_disjoint_set_poly_f,
    private field[R*WB_CW_SMALL] wb_disjoint_set_poly_g,
    private field[R][WB_CW_SMALL] ext_codewords,
    private field[W] codewords,
    private field[RW] left_row_inds,
    private field[G_R] garbage_words,
    private field[G_R] garbage_word_index,
    field[T] garbage_disjoint_set_poly_f,
    private field[G_R] garbage_disjoint_set_poly_g,
    // error correction and decoding
    private RowIndicatorVars row_indc,
    private field[W] corrected_codewords,
    private PolynomialResult[512] poly_witness,
    private BarcodeStats stats,
    private TableState[2*W] char_table_states,
    private field[2*W] chars
) {
  BarcodeRanges<RW,EC,EC_CW> ranges = BarcodeRanges { ec_level_range : RANGE_EC_LEVEL, num_rows_range : RANGE_NUM_ROWS, ec_cw_range : RANGE_1_513, powers_of_two : POWERS_OF_TWO };

  assert(full_circuit::<IR, IC, R, C, R_START, C_START, L_SMALL, TABLE_LEN_SMALL, G_R, G_B_SMALL, G_WW_SMALL, G_NB_SMALL, G_M_SMALL, G_LOGM_SMALL, WB_B_SMALL, WB_WW_SMALL, WB_NB_SMALL, WB_M_SMALL, WB_LOGM_SMALL, WB_CW_SMALL, G_CW_SMALL, RW, W, EC, EC_CW, QBITS>(
    image,
    bin_image,
    // block_measurement inputs
    well_behaved,
    wb_inds,
    ind_counts,
    garbage_image,
    garbage_inds,
    num_zero_rows,
    wb_lookups,
    wb_blocks,
    wb_baseB_decomps,
    g_lookups,
    g_blocks,
    g_baseB_decomps,
    WB_CHUNK_LOOKUP_TABLE_SMALL,
    WB_POWERS_OF_B_SMALL,
    WB_RANGE_CHECK_TABLE,
    G_CHUNK_LOOKUP_TABLE_SMALL,
    G_POWERS_OF_B_SMALL,
    G_RANGE_CHECK_TABLE,
    WB_WORDS_RANGE_TABLE,
    G_WORDS_RANGE_TABLE,
    // make_words inputs
    wb_normalized_widths,
    g_normalized_widths,
    // check_codewords_and_garbage inputs
    words_with_dummies,
    wb_disjoint_set_poly_f,
    wb_disjoint_set_poly_g,
    ext_codewords,
    codewords,
    left_row_inds,
    garbage_words,
    garbage_word_index,
    garbage_disjoint_set_poly_f,
    garbage_disjoint_set_poly_g,
    // error correction and decoding
    ranges,
    row_indc,
    corrected_codewords,
    poly_witness,
    stats,
    char_table_states,
    chars
  ));
}
