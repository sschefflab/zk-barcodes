from "EMBED" import sample_challenge;

def switch_color(field curr_color) -> field {
    field new_color = if (curr_color == 0) {
        1
    } else {
        0
    };
    return(new_color);
}

// returns block measurements, but spaced out with zero's
def measure_blocks_in_row<C>(field[C] pixels) -> field[C] {
    field[C] mut measured_blocks = [0; C];
    field mut curr_color = 0; // black
    assert(pixels[0] == curr_color);
    field mut curr_len = 1;

    for u32 i in 1..C {
        (field, field) acc = if (curr_color == pixels[i]) {
            (curr_len + 1, curr_color)
        } else {
            (1, switch_color(curr_color))
        };

        field for_arr = if (curr_color == acc.1) {
            0
        } else {
            curr_len
        };

        measured_blocks[i] = for_arr;
        curr_len = acc.0;
        curr_color = acc.1;
    }

    return(measured_blocks);
}

def check_block_consistency<C>(field[C] measured_blocks, field[C] prover_blocks) -> bool {
    field beta = sample_challenge([...measured_blocks, ...prover_blocks]);

    field mut result1 = 0;
    field mut pow = 1;
    for u32 i in 0..C {
        (field, field) acc = if (measured_blocks[i] == 0) {
            (0, pow)
        } else {
            (measured_blocks[i] * pow, pow * beta)
        };
        result1 = result1 + acc.0;
        pow = acc.1;
    }

    field mut result2 = 0;
    pow = 1;
    for u32 i in 0..C {
        result2 = result2 + pow * prover_blocks[i];
        pow = pow * beta;
    }

    return(result1 == result2);
}

def measure_blocks<R,C>(field[R][C] pixels, field[R][C] blocks) -> bool {
    bool mut block_consistency = true;

    for u32 r in 0..R {
        field[C] measured_blocks = measure_blocks_in_row(pixels[r]);
        block_consistency = block_consistency && check_block_consistency(measured_blocks, blocks[r]);
    }

    return(block_consistency);
}

// test function
const u32 R = 720;
const u32 C = 6;

def main(private field[R][C] pixels, private field[R][C] blocks) -> field[C] {
    return(measure_blocks_in_row(pixels[0]));
    // assert(measure_blocks(pixels, blocks));
}
