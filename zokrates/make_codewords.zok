from "./codeword_lookup.zok" import lookup_codeword;

def check_dummies<W>(field[W] words, field[W] words_with_dummies) -> bool {
    bool mut correct = true;
    
    for u32 i in 0..W {
        bool word_correct = (words[i] == words_with_dummies[i] || words_with_dummies[i] == 0);
        correct = correct && word_correct;
    }

    return(correct);
}

def check_codewords<W>(field[W] words, field[W] words_with_dummies, field[W] codewords) -> bool {
    bool dummies_ok = check_dummies(words, words_with_dummies);

    for u32 i in 0..W {
        bool is_true = lookup_codeword(words_with_dummies[i], codewords[i]);
    }

    return(dummies_ok);
}

// test function
const u32 W = 2;

def main(field[W] words, private field[W] words_with_dummies, private field[W] codewords) -> bool {
    return(check_codewords(words, words_with_dummies, codewords));
}
