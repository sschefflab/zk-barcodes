from "./codeword_lookup.zok" import lookup_codeword;

def check_dummies<W>(field[W] words, field[W] words_with_dummies) -> bool {
    bool mut correct = true;
    
    for u32 i in 0..W {
        bool word_correct = (words[i] == words_with_dummies[i] || words_with_dummies[i] == 0);
        correct = correct && word_correct;
    }

    return(correct);
}

def compute_codewords<W>(field[W] words, field[W] words_with_dummies) -> field[W] {
    assert(check_dummies(words, words_with_dummies));

    field[W] mut codewords = [0; W];
    for u32 i in 0..W {
        codewords[i] = lookup_codeword(words_with_dummies[i]);
    }
    return(codewords);
}

// test function
const u32 W = 2;

def main(field[W] words, field[W] words_with_dummies) -> field[W] {
    return(compute_codewords(words, words_with_dummies));
}
