from "EMBED" import sample_challenge;
from "./codeword_lookup.zok" import lookup_codeword, START, STOP, ZERO;

const field DUMMY = 919;

def check_dummies<CW>(field[CW] words, field[CW] words_with_dummies) -> bool {
    bool mut correct = true;
    
    for u32 i in 0..CW {
        bool word_correct = ((words_with_dummies[i] * (words[i] - words_with_dummies[i])) == 0);
        correct = correct && word_correct;
    }

    return(correct);
}

def check_codewords<R,CW, W>(field[R][CW] words, field[R][CW] words_with_dummies, field[R][CW] ext_codewords, field[W] codewords, field[R] left_row_inds) -> bool {
    bool mut dummies_ok = true;
    for u32 r in 0..R {
        dummies_ok = dummies_ok && check_dummies(words[r], words_with_dummies[r]);
    }

    u32 N = R * CW;

    field[N] mut cw_and_dummies = [DUMMY; N]; // start it off filled with dummies
    field[R] mut row_inds_and_dummies = [0; R];
    
    bool mut cw_ok = true;
    for u32 i in 0..R {
        for u32 j in 0..CW {
            u32 cw_idx = i * CW + j;

            field ext_cw = ext_codewords[i][j];
            
            // this always returns true, but it does an assert inside
            bool lookup = lookup_codeword(words_with_dummies[i][j], ext_cw);

            bool acc = if (j == 0) {
                (ext_cw == START || ext_cw == ZERO)
            } else {
                if (j == CW - 1) {
                    ext_cw == ZERO // this should be garbage after the stop indicator
                } else {
                    if (j == CW - 2) {
                        (ext_cw == STOP || ext_cw == ZERO)
                    } else {
                        true // row indicators, real codewords, or garbage - nothing to check yet
                    }
                }
            };

            cw_ok = cw_ok && acc;

            // only some columns are left row indicators - only modify the row indicators if so
            field to_add_row_ind = if (j == 1) {
                ext_cw
            } else {
                0
            };

            row_inds_and_dummies[i] = row_inds_and_dummies[i] + to_add_row_ind;

            // only some columns are codewords - only modify codewords if so
            // These operators are ok since we are operating on constant values
            // TODO: confirm these aren't adding a ton of constraints
            field to_add_cw = if (j >= 2 && j <= CW - 4) {
               ext_cw - DUMMY // subtract out the dummy codeword we filled everything with
            } else {
                0
            };

            cw_and_dummies[cw_idx] = cw_and_dummies[cw_idx] + to_add_cw;
        }
    }

    // randomized PIT test that cw_and_dummies is consistent with codewords
    field beta = sample_challenge([...cw_and_dummies, ...codewords]);

    // Compute polynomial for array that contains dummies
    field mut result1 = 0;
    field mut pow = 1;
    for u32 i in 0..N {
        u32 ind = N - i - 1; // this array is reversed from the codewords array
        (field, field) acc = if (cw_and_dummies[ind] == DUMMY) {
            (0, pow)
        } else {
            (cw_and_dummies[ind] * pow, pow * beta)
        };
        result1 = result1 + acc.0;
        pow = acc.1;
    }

    // Compute polynomial for codeword array.
    field mut result2 = 0;
    pow = 1;
    for u32 i in 0..W {
        result2 = result2 + codewords[i] * pow;
        pow = pow * beta;
    }

    bool codewords_consistent = result1 == result2;

    // randomized PIT test that row_inds_and_dummies related to left_row_inds
    field gamma = sample_challenge([...row_inds_and_dummies, ...left_row_inds]);
    result1 = 0;
    result2 = 0;
    pow = 1;

    for u32 i in 0..R {
        (field, field) acc = if (row_inds_and_dummies[i] == DUMMY) {
            (0, pow)
        } else {
            (row_inds_and_dummies[i] * pow, pow * gamma)
        };
        result1 = result1 + acc.0;
        pow = acc.1;
    }

    pow = 1;
    for u32 i in 0..R {
        result2 = result2 + pow * left_row_inds[i];
        pow = pow * gamma;
    }

    bool row_inds_consistent = result1 == result2;

    return(dummies_ok && cw_ok && codewords_consistent && row_inds_consistent);
}

// test function
const u32 R = 2;
const u32 CW = 6;
const u32 W = 2;

def main(field[R][CW] words, private field[R][CW] words_with_dummies, private field[R][CW] ext_codewords, private field[W] codewords, private field[R] left_row_inds) {
    assert(check_codewords(words, words_with_dummies, ext_codewords, codewords, left_row_inds));
}
