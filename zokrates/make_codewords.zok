// Go from words (bsbsbsbs patterns) to codewords
// Ensure that decoding is done correctly with the lookup table and discarded words are appropriate
// Checks data codewords and left row indicators

from "EMBED" import sample_challenge;
from "./codeword_lookup.zok" import lookup_codeword, START, STOP, ZERO, VALID_WORDS;
from "./not_in_table.zok" import disjoint_sets;

const field DUMMY = 919;
const field KNOWN_GARBAGE = 1;
const u32 T = 2789; // the number of decodable words (bsbsbsbs patterns)

def check_dummies<CW>(field[CW] words, field[CW] words_with_dummies) -> bool {
    bool mut correct = true;
    
    for u32 i in 0..CW {
        bool word_correct = ((words_with_dummies[i] * (words[i] - words_with_dummies[i])) == 0);
        correct = correct && word_correct;
    }

    return(correct);
}

def check_codewords<R, RW, CW, W>(
    field[R][CW] words,
    field[R][CW] words_with_dummies,
    field[T] disjoint_set_poly_f,
    field[R*CW] disjoint_set_poly_g,
    field[R][CW] ext_codewords,
    field[W] codewords,
    field[RW] left_row_inds
) -> bool {
    bool mut dummies_ok = true;
    for u32 r in 0..R {
        dummies_ok = dummies_ok && check_dummies(words[r], words_with_dummies[r]);
    }

    u32 N = R * CW;

    field[N] mut cw_and_dummies = [DUMMY; N]; // start it off filled with dummies
    field[R] mut row_inds_and_dummies = [0; R];

    field[N] mut garbage = [ KNOWN_GARBAGE; N ];

    // TODO: this assumes that every row has the max number of data words. Need to dynamically look for the stop symbol.
    bool mut cw_ok = true;
    for u32 i in 0..R {
        for u32 j in 0..CW {
            u32 cw_idx = i * CW + j;

            field ext_cw = ext_codewords[i][j];

            // put the garbage that is not equal to the thing right above it into the array to check later.
            // Otherwise, leave the array at the known garbage that it is.
            field curr_word = words[i][j];
            field curr_word_or_dummy = words_with_dummies[i][j];
            field to_add_to_garbage = if (curr_word_or_dummy == 0) {
                if (i == 0) {
                   curr_word - KNOWN_GARBAGE
                } else {
                    if (curr_word == words[i-1][j]) {
                        0
                    } else {
                        curr_word - KNOWN_GARBAGE
                    }
                }
            } else {
                0
            };

            garbage[cw_idx] = garbage[cw_idx] + to_add_to_garbage;
            
            // this always returns true, but it does an assert inside
            bool lookup = lookup_codeword(curr_word_or_dummy, ext_cw);

            bool acc = if (j == 0) {
                (ext_cw == START || ext_cw == ZERO)
            } else {
                if (j == CW - 1) {
                    ext_cw == ZERO // this should be garbage after the stop indicator
                } else {
                    if (j == CW - 2) {
                        (ext_cw == STOP || ext_cw == ZERO)
                    } else {
                        true // row indicators, real codewords, or garbage - nothing to check yet
                    }
                }
            };

            cw_ok = cw_ok && acc;

            // only some columns are left row indicators - only modify the row indicators if so
            field to_add_row_ind = if (j == 1) {
                ext_cw
            } else {
                0
            };

            row_inds_and_dummies[i] = row_inds_and_dummies[i] + to_add_row_ind;

            // only some columns are codewords - only modify codewords if so
            // These operators are ok since we are operating on constant values
            // TODO: confirm these aren't adding a ton of constraints
            field to_add_cw = if (j >= 2 && j <= CW - 4) {
               ext_cw - DUMMY // subtract out the dummy codeword we filled everything with
            } else {
                0
            };

            cw_and_dummies[cw_idx] = cw_and_dummies[cw_idx] + to_add_cw;
        }
    }

    // check that the garbage is in fact not in the decodable codewords
    bool garbage_ok = disjoint_sets::<N,T>(garbage, VALID_WORDS, disjoint_set_poly_f, disjoint_set_poly_g);

    // randomized PIT test that cw_and_dummies is consistent with codewords
    field beta = sample_challenge([...cw_and_dummies, ...codewords]);

    // Compute polynomial for array that contains dummies
    field mut result1 = 0;
    field mut pow = 1;
    for u32 i in 0..N {
        u32 ind = N - i - 1; // this array is reversed from the codewords array
        (field, field) acc = if (cw_and_dummies[ind] == DUMMY) {
            (0, pow)
        } else {
            (cw_and_dummies[ind] * pow, pow * beta)
        };
        result1 = result1 + acc.0;
        pow = acc.1;
    }

    // Compute polynomial for codeword array.
    field mut result2 = 0;
    pow = 1;
    for u32 i in 0..W {
        result2 = result2 + codewords[i] * pow;
        pow = pow * beta;
    }

    bool codewords_consistent = result1 == result2;

    // randomized PIT test that row_inds_and_dummies related to left_row_inds
    field gamma = sample_challenge([...row_inds_and_dummies, ...left_row_inds]);
    result1 = 0;
    result2 = 0;
    pow = 1;

    for u32 i in 0..R {
        (field, field) acc = if (row_inds_and_dummies[i] == DUMMY) {
            (0, pow)
        } else {
            (row_inds_and_dummies[i] * pow, pow * gamma)
        };
        result1 = result1 + acc.0;
        pow = acc.1;
    }

    pow = 1;
    for u32 i in 0..RW {
        result2 = result2 + pow * left_row_inds[i];
        pow = pow * gamma;
    }

    bool row_inds_consistent = result1 == result2;

    return(dummies_ok && cw_ok && garbage_ok && codewords_consistent && row_inds_consistent);
}

// test function
const u32 R = 4;
const u32 CW = 6; // should actually be B / 8
const u32 W = 2;
const u32 RW = 2; // the number of logical barcode rows. Should be 90.

def main(
    field[R][CW] words,
    private field[R][CW] words_with_dummies,
    field[T] disjoint_set_poly_f,
    private field[R*CW] disjoint_set_poly_g,
    private field[R][CW] ext_codewords,
    private field[W] codewords,
    private field[RW] left_row_inds
) {
    assert(check_codewords(words, words_with_dummies, disjoint_set_poly_f, disjoint_set_poly_g, ext_codewords, codewords, left_row_inds));
}
