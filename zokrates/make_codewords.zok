// Go from words (bsbsbsbs patterns) to codewords
// Ensure that decoding is done correctly with the lookup table and discarded words are appropriate
// Checks data codewords and left row indicators
// Also checks that garbage rows pulled out during block measurement contain only garbage

from "EMBED" import sample_challenge, u32_to_field;
from "./utils.zok" import flatten_array;
from "./codeword_lookup.zok" import lookup_codeword, START, STOP, ZERO, VALID_WORDS;
from "./not_in_table.zok" import disjoint_sets;

const field DUMMY = 919;
const field KNOWN_GARBAGE = 1;
const u32 T = 2789; // the number of decodable words (six width )

def check_dummies<CW>(field[CW] words, field[CW] words_with_dummies) -> bool {
    bool mut correct = true;
    
    for u32 i in 0..CW {
        bool word_correct = ((words_with_dummies[i] * (words[i] - words_with_dummies[i])) == 0);
        correct = correct && word_correct;
    }

    return(correct);
}

// This should operate on the "well-behaved" rows of the image.
// Even though the rows are well-behaved, there may still be garbage since the words array must account for the largest possible barcode.
// Also, there may be garbage terms at the edges, for example, after the STOP symbol.
// Treat this array as the image, pull out garbage, and check that it is garbage.
// Check that the non-garbage parts are consistent with the prover-provided codewords.
def check_codewords<R, RW, CW, W>(
    field[R][CW] words,
    field[R][CW] words_with_dummies,
    field[T] disjoint_set_poly_f,
    field[R*CW] disjoint_set_poly_g,
    field[R][CW] ext_codewords,
    field[W] codewords, // expected to be left-padded with zeros to meet length W
    field[RW] left_row_inds
) -> bool {
    bool mut dummies_ok = true;
    for u32 r in 0..R {
        dummies_ok = dummies_ok && check_dummies(words[r], words_with_dummies[r]);
    }

    u32 N = R * CW;

    field[N] mut cw_and_dummies = [DUMMY; N]; // start it off filled with dummies
    field[R] mut row_inds_and_dummies = [DUMMY; R];

    field[N] mut garbage = [ KNOWN_GARBAGE; N ];

    bool mut cw_ok = true;
    for u32 i in 0..R {
        bool mut no_start = false;
        bool mut found_stop = false;
        for u32 j in 0..CW {
            u32 cw_idx = i * CW + j;

            field ext_cw = ext_codewords[i][j];

            // put the garbage that is not equal to the thing right above it into the array to check later.
            // Otherwise, leave the array at the known garbage that it is.
            field curr_word = words[i][j];
            field curr_word_or_dummy = words_with_dummies[i][j];
            field to_add_to_garbage = if (curr_word_or_dummy == 0) {
                if (i == 0) {
                   curr_word - KNOWN_GARBAGE
                } else {
                    if (curr_word == words[i-1][j]) {
                        0
                    } else {
                        curr_word - KNOWN_GARBAGE
                    }
                }
            } else {
                0
            };

            garbage[cw_idx] = garbage[cw_idx] + to_add_to_garbage;
            
            // this always returns true, but it does an assert inside
            bool lookup = lookup_codeword(curr_word_or_dummy, ext_cw);

            bool acc_no_start = if (j == 0 && curr_word_or_dummy == ZERO) {
                true
            } else {
                false
            };
            no_start = no_start || acc_no_start;

            bool acc = if (j == 0) {
                (curr_word_or_dummy == START || curr_word_or_dummy == ZERO)
            } else {
                if (no_start || found_stop) {
                    curr_word_or_dummy == ZERO // all codewords after STOP should be garbage
                } else {
                    true
                }
            };

            cw_ok = cw_ok && acc;

            // set found_stop flag appropriately
            bool acc_found_stop = if (curr_word_or_dummy == STOP) {
                true
            } else {
                false
            };
            found_stop = found_stop || acc_found_stop;

            // only some columns are left row indicators - only modify the row indicators if so
            field to_add_row_ind = if (j == 1) {
                ext_cw - DUMMY // subtract out the dummy codeword we filled everything with
            } else {
                0
            };
            row_inds_and_dummies[i] = row_inds_and_dummies[i] + to_add_row_ind;

            // only some columns are codewords - only modify codewords if so
            field to_add_cw = if (j >= 2 && !found_stop) {
               ext_cw - DUMMY // subtract out the dummy codeword we filled everything with
            } else {
                0
            };

            // remove previous codewordd if we just found stop - this is a right row indicator
            u32 idx_to_set = if (cw_idx == 0) {
                0
            } else {
                cw_idx - 1
            };
            
            field to_set_previous = if (cw_idx > 0) && (acc_found_stop) {
                DUMMY
            } else {
                if (cw_idx == 0) {
                    DUMMY // this is the start - we haven't set anything yet. Just set it to the DUMMY value it already is.
                } else {
                    cw_and_dummies[cw_idx - 1]
                }
            };

            cw_and_dummies[idx_to_set] = to_set_previous; // idx_to_set is actually constant, so this should be fine
            cw_and_dummies[cw_idx] = cw_and_dummies[cw_idx] + to_add_cw;
        }
    }

    // check that the garbage is in fact not in the decodable codewords
    bool garbage_ok = disjoint_sets::<N,T>(garbage, VALID_WORDS, disjoint_set_poly_f, disjoint_set_poly_g);

    // randomized PIT test that cw_and_dummies is consistent with codewords
    field beta = sample_challenge([...cw_and_dummies, ...codewords]);

    // Compute polynomial for array that contains dummies
    field mut result1 = 0;
    field mut pow = 1;
    for u32 i in 0..N {
        (field, field) acc = if (cw_and_dummies[i] == DUMMY) {
            (0, pow)
        } else {
            (cw_and_dummies[i] * pow, pow * beta)
        };
        result1 = result1 + acc.0;
        pow = acc.1;
    }

    // Compute polynomial for codeword array.
    // The codewords array is left-padded with zeros, so we need to be sure to skip those.
    // The SLD will always be non-zero and will be the first real codeword, so skip until we see the sld
    bool mut found_sld = false;
    field mut result2 = 0;
    pow = 1;
    for u32 i in 0..W {
        bool nonzero_cw = (codewords[i] != 0);
        found_sld = found_sld || nonzero_cw;

        (field, field) acc = if found_sld {
            (codewords[i] * pow, pow*beta)
        } else {
            (0, pow)
        };

        result2 = result2 + acc.0;
        pow = acc.1;
    }

    bool codewords_consistent = result1 == result2;

    // randomized PIT test that row_inds_and_dummies related to left_row_inds
    field gamma = sample_challenge([...row_inds_and_dummies, ...left_row_inds]);
    result1 = 0;
    result2 = 0;
    pow = 1;

    for u32 i in 0..R {
        (field, field) acc = if (row_inds_and_dummies[i] == DUMMY) {
            (0, pow)
        } else {
            (row_inds_and_dummies[i] * pow, pow * gamma)
        };
        result1 = result1 + acc.0;
        pow = acc.1;
    }

    pow = 1;
    for u32 i in 0..RW {
        result2 = result2 + pow * left_row_inds[i];
        pow = pow * gamma;
    }

    bool row_inds_consistent = result1 == result2;

    return(dummies_ok && cw_ok && garbage_ok && codewords_consistent && row_inds_consistent);
}

def check_garbage<G_R, G_CW>(
    field[G_R][G_CW] garbage_rows,
    field[G_R] garbage_words, // should be in the same order as garbage_inds and garbage_rows
    field[G_R] garbage_word_index,
    field[T] garbage_disjoint_set_poly_f,
    field[G_R] garbage_disjoint_set_poly_g
) -> bool {
    // Prove garbage_words are in their respective garbage_rows
    bool words_ok = true;
    for u32 r in 0..G_R {
        field mut equality_check = 0;
        for u32 c in 0..G_CW {
            field c_f = u32_to_field(c);
            field to_add = if (c_f == garbage_word_index[r]) {
                garbage_rows[r][c]
            } else {
                0
            };
            equality_check = equality_check + to_add;
        }
        words_ok = words_ok && (garbage_words[r] == equality_check);
    }

    // Prove all the garbage words are actually garbage
    bool garbage_is_garbage = disjoint_sets::<G_R, T>(garbage_words, VALID_WORDS, garbage_disjoint_set_poly_f, garbage_disjoint_set_poly_g);
    return(words_ok && garbage_is_garbage);
}

// Check codewords as above, but also check that rows pulled out as garbage during block measurement really are garbage.
def check_codewords_and_garbage<WB_R, WB_RW, WB_CW, G_R, G_CW, W>(
    field[WB_R][WB_CW] words,
    field[WB_R][WB_CW] words_with_dummies,
    field[T] wb_disjoint_set_poly_f,
    field[WB_R*WB_CW] wb_disjoint_set_poly_g,
    field[WB_R][WB_CW] ext_codewords,
    field[W] codewords,
    field[WB_RW] left_row_inds,
    field[G_R][G_CW] garbage_rows,
    field[G_R] garbage_words,
    field[G_R] garbage_word_index,
    field[T] garbage_disjoint_set_poly_f,
    field[G_R] garbage_disjoint_set_poly_g
) -> bool {
    bool wb_ok = check_codewords(words, words_with_dummies, wb_disjoint_set_poly_f, wb_disjoint_set_poly_g, ext_codewords, codewords, left_row_inds);
    bool garbage_ok = check_garbage(garbage_rows, garbage_words, garbage_word_index, garbage_disjoint_set_poly_f, garbage_disjoint_set_poly_g);
    return(wb_ok && garbage_ok);
}

// test function
const u32 R = 32;
const u32 CW = 35;
const u32 W = 2700;
const u32 RW = 90; // the max number of logical barcode rows. Should be 90.
const u32 G_R = 89; // the max number of garbage rows. Should be RW - 1 = 89
const u32 G_CW = 135;

def main(
    field[R][CW] words,
    private field[R][CW] words_with_dummies,
    field[T] wb_disjoint_set_poly_f,
    private field[R*CW] wb_disjoint_set_poly_g,
    private field[R][CW] ext_codewords,
    private field[W] codewords,
    private field[RW] left_row_inds,
    field[G_R][G_CW] garbage_rows,
    field[G_R] garbage_words,
    field[G_R] garbage_word_index,
    field[T] garbage_disjoint_set_poly_f,
    private field[G_R] garbage_disjoint_set_poly_g
) {
    assert(check_codewords_and_garbage(
        words,
        words_with_dummies,
        wb_disjoint_set_poly_f,
        wb_disjoint_set_poly_g,
        ext_codewords,
        codewords,
        left_row_inds,
        garbage_rows,
        garbage_words,
        garbage_word_index,
        garbage_disjoint_set_poly_f,
        garbage_disjoint_set_poly_g
    ));
}
