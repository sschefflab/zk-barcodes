from "./make_words.zok" import compute_words;
from "./make_codewords.zok" import check_codewords_and_garbage, T;
from "./block_measurement_const.zok" import WB_B, G_B;
from "./const_range_check.zok" import RANGE_0_206, RANGE_0_2160;

// NOTE: it is important that ALL of thee parameters match what was used to generate the witness in order for the proof to go through! The ones listed here and the imported ones.
const u32 R = 32;
const u32 G_R = 30;

const u32 RW = 31;         // max number of logical barcode rows
const u32 W = 930;

const u32 WB_WW = 103; // next available WW above ceil(360/5)=72
const u32 WB_NB = 273; // property of pdf417
const u32 WB_CW = 35; // property of pdf417

const u32 G_WW = 360; // image width
const u32 G_NB = 360; // image width
const u32 G_CW = 45; // image width / 8


def main(
    private field[R][WB_NB] wb_blocks,
    private field[G_R][G_NB] g_blocks,
    private field[R][WB_CW][8] wb_normalized_blocks,
    private field[G_R][G_CW][8] g_normalized_blocks,
    private field[R][WB_CW] words_with_dummies,
    field[T] wb_disjoint_set_poly_f,
    private field[R*WB_CW] wb_disjoint_set_poly_g,
    private field[R][WB_CW] ext_codewords,
    private field[W] codewords,
    private field[RW] left_row_inds,
    private field[G_R] garbage_words,
    private field[G_R] garbage_word_index,
    field[T] garbage_disjoint_set_poly_f,
    private field[G_R] garbage_disjoint_set_poly_g
) {
    field[R][WB_CW] words = compute_words::<R, WB_WW, WB_NB, WB_CW>(wb_blocks, wb_normalized_blocks, RANGE_0_206);
    field[G_R][G_CW] garbage_rows = compute_words::<G_R, G_WW, G_NB, G_CW>(g_blocks, g_normalized_blocks, RANGE_0_2160);

    assert(check_codewords_and_garbage::<R, RW, WB_CW, G_R, G_CW, W>(
        words,
        words_with_dummies,
        wb_disjoint_set_poly_f,
        wb_disjoint_set_poly_g,
        ext_codewords,
        codewords,
        left_row_inds,
        garbage_rows,
        garbage_words,
        garbage_word_index,
        garbage_disjoint_set_poly_f,
        garbage_disjoint_set_poly_g
    ));
}
