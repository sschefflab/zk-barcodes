from "EMBED" import sample_challenge;

def pit<D>(field[D] f, field[D] g) -> bool {
    field beta = sample_challenge([...f, ...g]);

    field mut result_f = 0;
    field mut result_g = 0;
    field mut pow = 1;

    // the first loop can be optimized away by just setting the initialization differently
    for u32 i in 0..D {
        result_f = result_f + f[i] * pow;
        // result_g = result_g + g[i] * pow;
        pow = pow * beta;
    }

    // return(result_f == result_g);
    return(result_f != 0);
}

// test function
const u32 D = 1080;

def main(private field[D] f, private field[D] g) {
    assert(pit(f,g));
}
