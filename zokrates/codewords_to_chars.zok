// Check character interpretation state machine for converting PDF417 codewords into characters.

from "EMBED" import sample_challenge, u32_to_field;
from "./const_range_check.zok" import RANGE_1_513;
from "./utils.zok" import diff_lookup, PAD_CODEWORD;
from "./char_lookup.zok" import TableState, check_table_state, check_transition;
from "./error_correction.zok" import BarcodeStats;

// a dummy table state that is used before decoding actually begins
const TableState ZERO_TABLE_STATE = TableState { base30_val: 0, char: 0, this_table: 0, next_table: 0, next_next_table: 0 };

// a pad table state that may be present between data and error correction codewords
const TableState PAD_TABLE_STATE = TableState { base30_val: 0, char: 32, this_table: 0, next_table: 0, next_next_table: 0 };

// a table state used for error correction codewords that shouldn't actually be decoded
const TableState EC_TABLE_STATE = TableState { base30_val: 0, char: 6, this_table: 0, next_table: 0, next_next_table: 0 };

// a table state used for the SLD
const TableState SLD_TABLE_STATE = TableState { base30_val: 0, char: 95, this_table: 0, next_table: 0, next_next_table: 0 };

def check_char_split(field codeword, field c1, field c2) -> bool {
    // no need to range check c1 and c2 here because they get range checked as part of valid state checking
    return(codeword == 30*c1 + c2);
}

// The input chars array should have no null characters. If that assumption does not hold, we will need to modify this code.
def codewords_to_chars<W>(field[W] corrected_codewords, TableState[2*W] table_states, field num_ec_codewords, field[2*W] chars) -> bool {
    bool mut correct_char_split = true;
    assert(table_states[0].this_table == 0);
    
    TableState mut prev_table_state = ZERO_TABLE_STATE;

    field[2*W] mut interpreted_chars = [0; 2*W];

    field mut num_sld_states = 0;

    for u32 i in 0..W {
        field codeword = corrected_codewords[i];
        TableState state1 = table_states[2*i];
        TableState state2 = table_states[2*i+1];

        // check that these are valid table states
        bool dummy1 = check_table_state(state1);
        bool dummy2 = check_table_state(state2);

        // check consistency of state1 with the previous state
        bool dummy3 = check_transition(prev_table_state, state1);

        // check consistency of state2 with state1
        bool dummy4 = check_transition(state1, state2);

        // set prev_table_state to state2 for the next looop
        prev_table_state = state2;

        field i_f = u32_to_field(i);

        // if we are in an error correction state, make sure we are in the error correction portion of the codewords array
        bool is_ec_cw = (state1 == EC_TABLE_STATE) && (state2 == EC_TABLE_STATE);
        field back_idx = u32_to_field(W - 1 - i);
        field to_compare = if is_ec_cw {
            num_ec_codewords // if we really are in an error correction state, the number of ec codewords should be greater than our W - 1 - i
        } else {
            back_idx +1 // otherwise, we don't care about this result - set it to something always greater than back_idx
        };

        bool always_true = diff_lookup(to_compare, back_idx, RANGE_1_513); // always returns true, but does an assert inside
        
        // Don't try to decode error correction codewords, pads, or higher-degree terms that are zero
        (bool, field, field, field) decode = if (!is_ec_cw) {
            if (codeword ==  PAD_CODEWORD) {
                ((state1 == PAD_TABLE_STATE) && (state2 == PAD_TABLE_STATE), 0, 0, 0)
            } else {
                if (state1 == SLD_TABLE_STATE && state2 == SLD_TABLE_STATE) {
                    (true, 0, 0, 2)
                } else {
                    // It's ok to decode zero states - they will just decode to null characters
                    // If we have some mix of non-codeword states here, they will fail to decode
                    (check_char_split(codeword, state1.base30_val, state2.base30_val), state1.char, state2.char, 0)
                }
            }
        } else {
            (true, 0, 0, 0) // we already checked the ec codewords states
        };

        correct_char_split = correct_char_split && decode.0;
        interpreted_chars[2*i] = decode.1;
        interpreted_chars[2*i + 1] = decode.2;
        num_sld_states = num_sld_states + decode.3;
    }

    bool correct_sld_states = num_sld_states == 2;

    field beta = sample_challenge([...interpreted_chars, ...chars]);

    field mut result1 = 0;
    field mut pow = 1;
    for u32 i in 0..2*W {
        (field, field) acc = if (interpreted_chars[i] == 0) {
            (0, pow)
        } else {
            (interpreted_chars[i] * pow, pow * beta)
        };
        result1 = result1 + acc.0;
        pow = acc.1;
    }

    field mut result2 = 0;
    pow = 1;
    for u32 i in 0..2*W {
        result2 = result2 + pow * chars[i];
        pow = pow * beta;
    }

    bool correct_chars = result1 == result2;
    
    return(correct_char_split && correct_sld_states && correct_chars);
}

// test function
const u32 W = 2700;

def main(private field[W] corrected_codewords, private TableState[2*W] char_table_states, private BarcodeStats stats, private field[2*W] chars) {
    assert(codewords_to_chars(corrected_codewords, char_table_states, stats.num_ec_codewords, chars));
}
