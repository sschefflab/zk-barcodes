// Test wrapper for binarize.zok with small image dimensions.
// R and C are set here for fast test compilation and proving.
// When changing R or C, also update generate_binarize.py to match.

from "../../zokrates/binarize.zok" import binarize;

const u32 R = 4;
const u32 C = 8;

def main(private field[R][C] image, private field[R][C] bin_image) -> () {
    assert(binarize(image, bin_image));
}
